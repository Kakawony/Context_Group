---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import data from '../../content/pages/blog-index/index.json';

// Получаем все Markdown статьи в текущей папке с помощью Vite glob в Astro 5/6
const rawPosts = Object.values(import.meta.glob('./*.md', { eager: true })) as any[];
const posts = rawPosts.sort((a, b) => {
	const parseDate = (dStr: string) => {
		const [d, m, y] = dStr.split('.').map(Number);
		return new Date(y, m - 1, d).getTime();
	};
	return parseDate(b.frontmatter.date) - parseDate(a.frontmatter.date);
});

// Категории для хаба
const hubCategories = [
	{ id: 'all', name: 'Все материалы' },
	{ id: 'cases', name: 'Кейсы' },
	{ id: 'career', name: 'Моя карьера' }
];

// Нормализация категории из MD под наши фильтры
function getNormalizedCategory(categoryName: string) {
	const lower = categoryName.toLowerCase();
	if (lower.includes('кейс')) return 'cases';
	if (lower.includes('отрасл') || lower.includes('решен')) return 'industry';
	if (lower.includes('инструмент')) return 'tools';
	if (lower.includes('карьер')) return 'career';
	return 'industry'; // По умолчанию в отраслевые
}

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: data.faqItems.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
---

<Layout title={data.title} description={data.description}>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	<section class="hub-section">
		<div class="hub-glow"></div>
		<div class="container">
			<Breadcrumbs items={[{ label: data.breadcrumb }]} />
			
			<div class="hub-header">
				<span class="badge">{data.heroBadge}</span>
				<h1>{data.heroTitleLead}<span class="gradient-text">{data.heroTitleAccent}</span></h1>
				<p>{data.heroDesc}</p>
			</div>

			<!-- Фильтры-табы -->
			<div class="hub-filters">
				{hubCategories.map(cat => (
					<a 
						href={cat.id === 'all' ? '/blog' : `/blog/${cat.id}`} 
						class={`filter-btn ${cat.id === 'all' ? 'active' : ''}`}
					>
						{cat.name}
					</a>
				))}
			</div>

			<div class="hub-grid" id="hubGrid">
				{posts.map((post) => {
					const filterCategory = getNormalizedCategory(post.frontmatter.category);
					return (
						<a href={post.url} class="glass-card hub-card" data-category={filterCategory}>
							<div class="hub-card-visual">
								{post.frontmatter.image ? (
									<img src={post.frontmatter.image} alt={post.frontmatter.title} class="hub-card-image" />
								) : (
									<div class="hub-card-icon">
										<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
											<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line>
										</svg>
									</div>
								)}
							</div>
							<div class="hub-card-content">
								<div class="hub-card-meta">
									<span class="category-tag">{post.frontmatter.category}</span>
									<span class="meta-separator">&bull;</span>
									<time>{post.frontmatter.date}</time>
									<span class="meta-separator">&bull;</span>
									<span>{post.frontmatter.readTime}</span>
								</div>
								<h3>{post.frontmatter.title}</h3>
								<p>{post.frontmatter.description}</p>
								<span class="read-more">Читать материал &rarr;</span>
							</div>
						</a>
					)
				})}
				<div class="empty-state" id="emptyState" style="display: none;">
					<div class="empty-icon">⏳</div>
					<h3>Материалы готовятся</h3>
					<p>Мы собираем экспертный контент для этого раздела. Загляните сюда чуть позже!</p>
				</div>
			</div>

			<!-- Большой экспертный SEO-текст -->
			<section class="seo-text-section" style="margin-top: 40px; border-top: 1px solid var(--glass-border); padding-top: 60px;">
				<div class="seo-text-content">
					<h2>{data.seoTitle}</h2>
					{data.seoParagraphs.map((p) => (
						<div set:html={p} />
					))}
				</div>

				<div class="faq-block">
					<h2>{data.faqTitle}</h2>
					{data.faqItems.map((item) => (
						<details class="faq-item">
							<summary>{item.q}</summary>
							<p>{item.a}</p>
						</details>
					))}
				</div>
			</section>
		</div>
	</section>
</Layout>

<!-- JS скрипт фильтрации удален, теперь работает через серверные роуты -->

<style>
	.hub-section {
		position: relative;
		padding: 60px 0 100px 0;
		overflow: hidden;
		min-height: calc(100vh - 200px);
	}

	.hub-glow {
		position: absolute;
		top: -100px;
		left: 50%;
		transform: translateX(-50%);
		width: 800px;
		height: 500px;
		background: radial-gradient(circle, var(--accent-purple-glow) 0%, rgba(13,15,20,0) 100%);
		filter: blur(80px);
		pointer-events: none;
		z-index: 1;
	}

	.hub-header {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 50px auto;
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: rgba(147, 51, 234, 0.1);
		border: 1px solid rgba(147, 51, 234, 0.2);
		padding: 6px 16px;
		border-radius: 9999px;
		font-size: 0.85rem;
		font-family: 'Outfit', sans-serif;
		font-weight: 500;
		color: var(--accent-purple);
		margin-bottom: 24px;
	}

	.hub-header h1 {
		font-size: 3rem;
		margin-bottom: 20px;
		letter-spacing: -1px;
	}

	.hub-header p {
		color: var(--text-muted);
		font-size: 1.1rem;
		line-height: 1.6;
	}

	/* Табы (фильтры) */
	.hub-filters {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-bottom: 50px;
		position: relative;
		z-index: 2;
	}

	.filter-btn {
		background: var(--bg-dark-card);
		border: 1px solid var(--glass-border);
		color: var(--text-muted);
		padding: 10px 24px;
		border-radius: 8px;
		font-family: 'Inter', sans-serif;
		font-size: 0.95rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.filter-btn:hover {
		background: var(--bg-dark-hover);
		color: var(--text-main);
		border-color: rgba(147, 51, 234, 0.3);
		transform: translateY(-2px);
	}

	.filter-btn.active {
		background: var(--grad-primary);
		border-color: transparent;
		color: #fff;
		box-shadow: 0 4px 15px rgba(147, 51, 234, 0.3);
	}

	/* Сетка карточек */
	.hub-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 30px;
		position: relative;
		z-index: 2;
		margin-bottom: 80px;
	}

	.hub-card {
		padding: 0;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		transition: all 0.3s ease; /* Для анимации фильтра */
		transform-origin: center;
	}

	.hub-card:hover {
		transform: translateY(-5px);
		border-color: var(--glass-border-hover);
		box-shadow: 0 10px 30px rgba(0,0,0, 0.2);
	}
	html.light .hub-card:hover {
		box-shadow: 0 10px 30px rgba(147, 51, 234, 0.1);
	}

	.hub-card-visual {
		width: 100%;
		height: 180px;
		background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(147, 51, 234, 0.05) 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		border-bottom: 1px solid var(--glass-border);
		position: relative;
		overflow: hidden;
	}
	
	.hub-card-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}
	
	.hub-card:hover .hub-card-image {
		transform: scale(1.05);
	}

	.hub-card-icon {
		width: 64px;
		height: 64px;
		background: var(--bg-dark);
		border: 1px solid var(--glass-border);
		border-radius: 16px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--accent-purple);
		box-shadow: 0 8px 24px rgba(0,0,0,0.2);
	}
	html.light .hub-card-icon {
		background: #fff;
		box-shadow: 0 8px 24px rgba(147, 51, 234, 0.1);
	}

	.hub-card-content {
		padding: 30px;
		display: flex;
		flex-direction: column;
		gap: 16px;
		flex-grow: 1;
	}

	.hub-card-meta {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.85rem;
		color: var(--text-dim);
	}

	.category-tag {
		background: rgba(6, 182, 212, 0.1);
		border: 1px solid rgba(6, 182, 212, 0.2);
		color: var(--accent-cyan);
		padding: 2px 10px;
		border-radius: 9999px;
		font-weight: 500;
		font-size: 0.75rem;
	}

	.meta-separator {
		color: var(--text-dim);
	}

	.hub-card h3 {
		font-size: 1.4rem;
		line-height: 1.35;
		transition: color 0.25s ease;
	}

	.hub-card:hover h3 {
		color: var(--accent-purple);
	}

	.hub-card p {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.65;
		flex-grow: 1;
	}

	.read-more {
		font-weight: 700;
		font-size: 0.95rem;
		letter-spacing: 0.2px;
		align-self: flex-start;
		margin-top: auto;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--accent-cyan);
		background: linear-gradient(90deg, var(--accent-cyan), var(--accent-cyan));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		transition: gap 0.25s ease, filter 0.25s ease;
	}

	.hub-card:hover .read-more {
		gap: 12px; /* стрелочка уезжает + смена цвета на фирменный градиент */
		background: var(--grad-primary);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		filter: drop-shadow(0 0 10px rgba(249, 6, 79, 0.25));
	}

	/* Пустое состояние (Заглушка) */
	.empty-state {
		grid-column: 1 / -1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 60px 20px;
		text-align: center;
		background: var(--glass-bg);
		border: 1px dashed var(--glass-border);
		border-radius: 24px;
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.empty-icon {
		font-size: 3rem;
		margin-bottom: 20px;
		opacity: 0.5;
	}

	.empty-state h3 {
		font-size: 1.5rem;
		margin-bottom: 10px;
	}

	.empty-state p {
		color: var(--text-muted);
		max-width: 400px;
	}

	/* SEO-текст и FAQ */
	.seo-text-content { max-width: 820px; margin: 0 auto; position: relative; z-index: 2; }
	.seo-text-content h2 { font-size: 1.9rem; margin-bottom: 16px; line-height: 1.3; position: relative; padding-left: 20px; }
	.seo-text-content h2::before {
		content: ''; position: absolute; left: 0; top: 4px; bottom: 4px;
		width: 4px; border-radius: 4px; background: var(--grad-primary);
		box-shadow: 0 0 12px var(--accent-purple-glow);
	}
	.seo-text-content h3 { font-size: 1.3rem; margin: 28px 0 12px; position: relative; padding-left: 18px; }
	.seo-text-content h3::before {
		content: ''; position: absolute; left: 0; top: 0.42em;
		width: 9px; height: 9px; border-radius: 2px;
		background: var(--accent-cyan); box-shadow: 0 0 10px var(--accent-cyan-glow);
	}
	.seo-text-content p { color: var(--text-muted); line-height: 1.7; margin-bottom: 16px; font-size: 1.05rem; }
	.seo-text-content a { color: var(--accent-cyan); text-decoration: none; }
	.seo-text-content a:hover { text-decoration: underline; }

	.faq-block { max-width: 820px; margin: 50px auto 0; position: relative; z-index: 2; }
	.faq-block h2 { font-size: 1.9rem; margin-bottom: 20px; line-height: 1.3; }
	.faq-item {
		border: 1px solid var(--glass-border);
		border-radius: 12px;
		padding: 18px 22px;
		margin-bottom: 12px;
		background: rgba(255, 255, 255, 0.015);
	}
	html.light .faq-item { background: rgba(0, 0, 0, 0.015); }
	.faq-item summary {
		cursor: pointer;
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--text-main);
		list-style: none;
		display: flex;
		justify-content: space-between;
		gap: 12px;
	}
	.faq-item summary::after { content: '+'; color: var(--accent-cyan); font-size: 1.4rem; line-height: 1; }
	.faq-item[open] summary::after { content: '−'; }
	.faq-item p { margin-top: 12px; color: var(--text-muted); line-height: 1.65; font-size: 0.98rem; }

	@media (max-width: 768px) {
		.hub-header h1 {
			font-size: 2.3rem;
		}
		.hub-filters {
			gap: 8px;
			margin-bottom: 30px;
		}
		.filter-btn {
			padding: 8px 16px;
			font-size: 0.85rem;
		}
		.hub-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

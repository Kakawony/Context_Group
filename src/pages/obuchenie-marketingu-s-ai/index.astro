---
import Layout from '../../layouts/Layout.astro';
import AiSphere from '../../components/AiSphere.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TeamSection from '../../components/TeamSection.astro';
// Контент страницы правится в админке /keystatic и пишется в этот JSON.
import edu from '../../content/pages/obuchenie/index.json';

const title = 'Обучение маркетингу в паре с AI — курс от практика | Context Group';
const description = 'Практический курс по маркетингу в связке с нейросетями: анализ конкурентов, SEO-конвейеры, performance-реклама, парсинг и автоматизация. Первый урок — бесплатно.';

const firstLessonUrl = '/obuchenie-marketingu-s-ai/urok-1-analiz-konkurentov';

const lessons = edu.lessons.map((l) => ({
	num: l.num,
	title: l.title,
	desc: l.desc,
	result: l.result,
	free: l.free,
	href: l.href ? l.href : undefined,
}));

// Статьи блога категории «Карьера»
const rawPosts = Object.values(import.meta.glob('../blog/*.md', { eager: true })) as any[];
const careerPosts = rawPosts
	.filter((p) => (p.frontmatter.category || '').toLowerCase().includes('карьер'))
	.sort((a, b) => {
		const toTime = (d: string) => {
			const [dd, mm, yy] = (d || '').split('.').map(Number);
			return dd ? new Date(yy, mm - 1, dd).getTime() : 0;
		};
		return toTime(b.frontmatter.date) - toTime(a.frontmatter.date);
	});
---

<Layout title={title} description={description}>
	<AiSphere alwaysVisible={true} scale={0.5} />

	<div class="page-container">
		<Breadcrumbs items={[
			{ label: 'Услуги', href: '/#services' },
			{ label: 'Обучение маркетингу с AI', href: '/obuchenie-marketingu-s-ai' }
		]} />

		<!-- Hero / интро -->
		<section class="edu-hero">
			<div class="container">
				<div class="edu-hero-inner">
					<span class="edu-tag">{edu.heroTag}</span>
					<h1>{edu.heroTitleLead} <span class="gradient-text">{edu.heroTitleAccent}</span></h1>
					<p class="edu-hero-lead">{edu.heroLead}</p>
					<div class="edu-price">
						<span class="edu-price-val">Полное обучение — <span class="gradient-text">{edu.priceValue}</span></span>
						<span class="edu-price-note">{edu.priceNote}</span>
					</div>
					<div class="edu-hero-cta">
						<a href={firstLessonUrl} class="btn btn-primary"><span>{edu.heroButton}</span></a>
					</div>
				</div>
			</div>
		</section>

		<!-- Программа обучения (8 уроков) -->
		<section id="program" class="edu-program">
			<div class="container">
				<div class="section-header">
					<h2>{edu.programTitleLead} <span class="gradient-text">{edu.programTitleAccent}</span></h2>
					<p>{edu.programSub}</p>
				</div>
				<div class="lessons-grid">
					{lessons.map((l) => (
						l.href ? (
							<a href={l.href} class="glass-card lesson-card lesson-card-active">
								<div class="lesson-card-top">
									<span class="lesson-num">{l.num}</span>
									{l.free && <span class="lesson-free">Бесплатно</span>}
								</div>
								<h3>{l.title}</h3>
								<p class="lesson-desc">{l.desc}</p>
								<p class="lesson-result"><span>Итог:</span> {l.result}</p>
								<span class="lesson-go">Смотреть урок &rarr;</span>
							</a>
						) : (
							<div class="glass-card lesson-card">
								<div class="lesson-card-top">
									<span class="lesson-num">{l.num}</span>
									<span class="lesson-soon">После оплаты</span>
								</div>
								<h3>{l.title}</h3>
								<p class="lesson-desc">{l.desc}</p>
								<p class="lesson-result"><span>Итог:</span> {l.result}</p>
							</div>
						)
					))}
				</div>
			</div>
		</section>

		<!-- Кто ведёт обучение -->
		<section class="edu-about">
			<div class="container">
				<TeamSection
					heading={edu.aboutHeading}
					subheading={edu.aboutSubheading}
				/>
			</div>
		</section>

		<!-- Заявка на индивидуальное полное обучение -->
		<section id="zayavka" class="edu-cta">
			<div class="container">
				<div class="glass-card edu-cta-card">
					<div class="edu-cta-glow"></div>
					<div class="edu-cta-info">
						<h2>{edu.offerTitleLead} <span class="gradient-text">{edu.offerTitleAccent}</span></h2>
						<p>{edu.offerText}</p>
						<div class="edu-cta-price">
							<span class="edu-cta-price-val">{edu.offerPriceValue}</span>
							<span class="edu-cta-price-note">{edu.offerPriceNote}</span>
						</div>
					</div>
					<form class="edu-form" action="/send" method="POST">
						<input type="hidden" name="_next" value="/thanks" />
						<input type="hidden" name="service" value="Обучение маркетингу с AI — заявка на полное обучение (40 000 ₽)" />
						<div class="edu-form-group">
							<input type="text" name="name" placeholder="Ваше имя" required />
						</div>
						<div class="edu-form-group">
							<input type="text" name="phone_or_tg" placeholder="Телефон или Telegram" required />
						</div>
						<button type="submit" class="btn btn-primary edu-form-submit"><span>{edu.offerButton}</span></button>
						<label class="edu-privacy">
							<input type="checkbox" name="agree" value="yes" required checked />
							<span>Согласен с <a href="/privacy" target="_blank">политикой конфиденциальности</a></span>
						</label>
					</form>
				</div>
			</div>
		</section>

		<!-- Раздел блога: карьера -->
		{careerPosts.length > 0 && (
			<section class="edu-career">
				<div class="container">
					<div class="section-header">
						<h2>{edu.careerTitleLead} <span class="gradient-text">{edu.careerTitleAccent}</span></h2>
						<p>{edu.careerSub}</p>
					</div>
					<div class="career-grid">
						{careerPosts.map((post) => (
							<a href={post.url} class="glass-card career-card">
								<div class="career-meta">
									<span class="career-tag">{post.frontmatter.category}</span>
									<time>{post.frontmatter.date}</time>
								</div>
								<h3>{post.frontmatter.title}</h3>
								<p>{post.frontmatter.description}</p>
								<span class="career-go">Читать материал &rarr;</span>
							</a>
						))}
					</div>
				</div>
			</section>
		)}
	</div>
</Layout>

<style>
	.page-container { padding-top: 100px; }

	/* Hero */
	.edu-hero { padding: 40px 0 40px; }
	.edu-hero-inner { max-width: 860px; }

	.edu-tag {
		display: inline-block;
		font-family: 'Outfit', sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		color: #fff;
		background: var(--grad-primary);
		padding: 5px 14px;
		border-radius: 999px;
		box-shadow: 0 0 14px var(--accent-purple-glow);
		margin-bottom: 20px;
	}

	.edu-hero h1 {
		font-size: 3rem;
		line-height: 1.15;
		margin-bottom: 22px;
	}

	.edu-hero-lead {
		color: var(--text-muted);
		font-size: 1.15rem;
		line-height: 1.7;
		margin-bottom: 30px;
	}

	.edu-price {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 6px 14px;
		margin-bottom: 24px;
	}
	.edu-price-val {
		font-family: 'Outfit', sans-serif;
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--text-main);
	}
	html.light .edu-price-val { color: hsl(224, 25%, 12%); }
	.edu-price-note {
		font-size: 0.92rem;
		color: var(--text-dim);
	}

	.edu-hero-cta {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}

	/* Общий заголовок секции */
	.section-header {
		text-align: center;
		margin-bottom: 48px;
	}
	.section-header h2 {
		font-size: 2.5rem;
		margin-bottom: 16px;
		position: relative;
		display: inline-block;
	}
	.section-header h2::after {
		content: '';
		display: block;
		width: 64px;
		height: 3px;
		margin: 16px auto 0;
		border-radius: 3px;
		background: var(--grad-primary);
		box-shadow: 0 0 12px var(--accent-purple-glow);
	}
	.section-header p {
		color: var(--text-muted);
		font-size: 1.1rem;
		max-width: 700px;
		margin: 0 auto;
	}

	/* Программа: 8 уроков */
	.edu-program { padding: 50px 0; }

	.lessons-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		max-width: 1080px;
		margin: 0 auto;
	}

	.lesson-card {
		padding: 26px 24px;
		border-radius: 16px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		text-decoration: none;
		color: inherit;
		transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
	}

	.lesson-card-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.lesson-num {
		font-family: 'Outfit', sans-serif;
		font-size: 1.7rem;
		font-weight: 800;
		line-height: 1;
		background: var(--grad-primary);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.lesson-free {
		font-family: 'Outfit', sans-serif;
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		color: #fff;
		background: var(--grad-primary);
		padding: 4px 10px;
		border-radius: 999px;
		box-shadow: 0 0 12px var(--accent-purple-glow);
	}

	.lesson-soon {
		font-family: 'Outfit', sans-serif;
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		color: var(--accent-purple);
		border: 1px solid rgba(147, 51, 234, 0.35);
		padding: 3px 10px;
		border-radius: 999px;
		white-space: nowrap;
	}

	.lesson-card h3 {
		font-size: 1.18rem;
		margin: 0;
		line-height: 1.35;
	}

	.lesson-desc {
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.55;
		margin: 0;
		flex-grow: 1;
	}

	.lesson-result {
		font-size: 0.9rem;
		line-height: 1.5;
		margin: 0;
		color: var(--text-main);
		padding-top: 12px;
		border-top: 1px solid var(--glass-border);
	}
	.lesson-result span {
		font-weight: 700;
		color: var(--accent-cyan);
	}

	html.light .lesson-result { color: hsl(224, 25%, 12%); }

	/* Активный (кликабельный) урок */
	.lesson-card-active {
		border-color: rgba(147, 51, 234, 0.35);
	}
	.lesson-card-active:hover {
		transform: translateY(-4px);
		border-color: rgba(147, 51, 234, 0.55);
		box-shadow: 0 12px 32px rgba(147, 51, 234, 0.14);
	}

	.lesson-go {
		font-weight: 700;
		font-size: 0.92rem;
		margin-top: 4px;
		background: linear-gradient(120deg, var(--accent-cyan) 0%, var(--accent-purple) 50%, var(--accent-cyan) 100%);
		background-size: 200% auto;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: textShine 4s linear infinite;
		transition: transform var(--transition-fast);
	}
	.lesson-card-active:hover .lesson-go {
		transform: translateX(6px);
		display: inline-block;
	}

	/* Кто ведёт обучение */
	.edu-about { padding: 50px 0; }

	/* CTA */
	.edu-cta { padding: 40px 0; }

	.edu-cta-card {
		max-width: 980px;
		margin: 0 auto;
		padding: 48px;
		display: grid;
		grid-template-columns: 1fr 360px;
		gap: 48px;
		align-items: center;
		position: relative;
		overflow: hidden;
	}

	.edu-cta-glow {
		position: absolute;
		top: -120px;
		left: -60px;
		width: 500px;
		height: 300px;
		background: radial-gradient(circle, var(--accent-purple-glow) 0%, transparent 70%);
		filter: blur(50px);
		pointer-events: none;
	}

	.edu-cta-info { position: relative; }

	.edu-cta-card h2 {
		font-size: 2rem;
		margin-bottom: 14px;
		line-height: 1.2;
	}
	.edu-cta-card p {
		color: var(--text-muted);
		font-size: 1.02rem;
		line-height: 1.65;
		margin: 0 0 22px;
	}

	.edu-cta-price {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 4px 12px;
	}
	.edu-cta-price-val {
		font-family: 'Outfit', sans-serif;
		font-size: 2rem;
		font-weight: 800;
		background: var(--grad-primary);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}
	.edu-cta-price-note {
		font-size: 0.9rem;
		color: var(--text-dim);
	}

	/* Форма заявки */
	.edu-form {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.edu-form-group input {
		width: 100%;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--glass-border);
		border-radius: 8px;
		padding: 12px 16px;
		color: #ffffff;
		font-family: inherit;
		font-size: 0.92rem;
		outline: none;
		transition: border-color var(--transition-fast);
	}
	html.light .edu-form-group input {
		background: rgba(0, 0, 0, 0.02);
		border: 1px solid rgba(0, 0, 0, 0.06);
		color: hsl(224, 25%, 12%);
	}
	.edu-form-group input:focus { border-color: var(--accent-cyan); }

	.edu-form-submit {
		width: 100%;
		justify-content: center;
		margin-top: 4px;
	}

	.edu-privacy {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		font-size: 0.74rem;
		color: var(--text-muted);
		line-height: 1.3;
		cursor: pointer;
	}
	.edu-privacy input {
		width: 15px;
		height: 15px;
		accent-color: var(--accent-cyan);
		flex-shrink: 0;
		cursor: pointer;
	}
	.edu-privacy a {
		color: var(--accent-cyan);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	/* Карьерный блог */
	.edu-career { padding: 50px 0 90px; }

	.career-grid {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 22px;
	}

	.career-card {
		flex: 0 1 calc((100% - 44px) / 3);
		padding: 28px 24px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		text-decoration: none;
		color: inherit;
		transition: transform var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
	}
	.career-card:hover {
		transform: translateY(-4px);
		border-color: rgba(147, 51, 234, 0.4);
		box-shadow: 0 12px 32px rgba(147, 51, 234, 0.12);
	}

	.career-meta {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 0.8rem;
	}
	.career-tag {
		background: rgba(147, 51, 234, 0.1);
		color: var(--accent-purple);
		padding: 4px 12px;
		border-radius: 20px;
		font-weight: 600;
	}
	.career-meta time { color: var(--text-dim); }

	.career-card h3 {
		font-size: 1.15rem;
		line-height: 1.4;
		margin: 0;
	}
	.career-card p {
		color: var(--text-muted);
		font-size: 0.9rem;
		line-height: 1.55;
		margin: 0;
		flex-grow: 1;
	}
	.career-go {
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--accent-cyan);
		transition: transform var(--transition-fast);
	}
	.career-card:hover .career-go {
		transform: translateX(6px);
		display: inline-block;
	}

	@keyframes textShine {
		0% { background-position: 0% center; }
		100% { background-position: 200% center; }
	}

	/* Адаптив */
	@media (max-width: 992px) {
		.lessons-grid { grid-template-columns: repeat(2, 1fr); }
		.career-card { flex-basis: calc((100% - 22px) / 2); }
		.edu-cta-card {
			grid-template-columns: 1fr;
			gap: 32px;
		}
	}

	@media (max-width: 768px) {
		.edu-hero h1 { font-size: 2rem; }
		.edu-hero-lead { font-size: 0.98rem; }
		.section-header h2 { font-size: 1.7rem; }
		.section-header { margin-bottom: 24px; }
		.lessons-grid { grid-template-columns: 1fr; }
		.career-card { flex-basis: 100%; }
		.edu-program, .edu-about, .edu-cta, .edu-career { padding: 30px 0; }
		.edu-cta-card { padding: 32px 20px; }
		.edu-cta-card h2 { font-size: 1.7rem; }
		.edu-hero-cta .btn { width: 100%; justify-content: center; }
	}
</style>

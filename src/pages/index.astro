---
import Layout from '../layouts/Layout.astro';
import AiSphere from '../components/AiSphere.astro';
import ServicesSection from '../components/ServicesSection.astro';
import Markdoc from '@markdoc/markdoc';
import data from '../content/pages/glavnaya/index.json';
import seo1raw from '../content/pages/glavnaya/index/seoBlock1.mdoc?raw';
import seo2raw from '../content/pages/glavnaya/index/seoBlock2.mdoc?raw';
import seo3raw from '../content/pages/glavnaya/index/seoBlock3.mdoc?raw';

// Rich-текст Keystatic (fields.document) хранится в отдельных .mdoc-файлах.
// Читаем raw (Vite подставляет содержимое на этапе билда) и рендерим через markdoc.
// НЕ используем createReader — он тянет node:path и падает под Cloudflare workerd (грабля №1 хендоффа).
const renderMdoc = (raw) => Markdoc.renderers.html(Markdoc.transform(Markdoc.parse(raw)));
const seo1 = renderMdoc(seo1raw);
const seo2 = renderMdoc(seo2raw);
const seo3 = renderMdoc(seo3raw);

// Meta-теги пока хардкод (как в пилоте «Обучение»); вынос в CMS — отдельный шаг.
const title = "Внедрение AI в бизнес — интеграция и разработка решений | Context Group";
const description = "Услуги интеграции и разработки искусственного интеллекта для бизнеса. Автоматизация бизнес-процессов «под ключ» в РФ.";

const faqItems = data.faq.items;

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};
---

<Layout title={title} description={description}>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	<!-- Декоративный элемент - AI-сфера, следящая за курсором -->
	<AiSphere alwaysVisible={false} scale={1} fullPage={true} />

	<!-- Секция Hero с анимированным фоном -->
	<section class="hero">
		<div class="hero-bg-glow"></div>
		<div class="container hero-container">
			<div class="hero-content">
				<h1>
					{data.hero.titleLead} <span class="gradient-text">{data.hero.titleAccent}</span> <br />
					{data.hero.titleTail}
				</h1>
				<p class="hero-lead">
					{data.hero.lead}
				</p>

				<p class="hero-experience"><span class="gradient-text">{data.hero.exp1}</span>{data.hero.expText1}<span class="gradient-text">{data.hero.exp2}</span>{data.hero.expText2}</p>

				<!-- Хештеги направлений. TODO: клик откроет окно со списком страниц, привязанных к тегу (data-tag) -->
				<div class="hero-tags">
					{data.hero.tags.map((t) => (
						t.href
							? <a class="hero-tag hero-tag-link" href={t.href} data-tag={t.dataTag}>{t.text}</a>
							: <span class="hero-tag" role="button" tabindex="0" data-tag={t.dataTag}>{t.text}</span>
					))}
				</div>

				<!-- Открытая форма захвата -->
				<form action="/send" method="POST" class="hero-form">
					<input type="hidden" name="_next" value="/thanks" />
					<div class="hero-form-row">
						<input type="text" name="name" required placeholder={data.hero.formName} />
						<input type="text" name="contact" required placeholder={data.hero.formContact} />
						<button type="submit" class="btn btn-primary hero-form-submit">
							<span>{data.hero.formButton}</span>
						</button>
					</div>
					<div class="privacy-agreement hero-privacy">
						<label class="checkbox-label">
							<input type="checkbox" name="agree" value="yes" required checked />
							<span class="privacy-text">Я согласен с <a href="/privacy" target="_blank">политикой конфиденциальности</a></span>
						</label>
					</div>
				</form>
			</div>
			
			<!-- Декоративный элемент - AI-сфера, следящая за курсором -->
			<div class="hero-visual">
			</div>
		</div>
	</section>

	<!-- Секция Услуг (тексты из CMS) -->
	<ServicesSection titleLead={data.services.titleLead} titleAccent={data.services.titleAccent} items={data.services.items} />

	<!-- Обучение маркетингу в паре с AI (компактный баннер сразу после услуг) -->
	<section class="home-edu">
		<div class="container">
			<div class="glass-card home-edu-card">
				<div class="home-edu-text">
					<span class="home-edu-tag">{data.edu.tag}</span>
					<h2>{data.edu.titleLead} <span class="gradient-text">{data.edu.titleAccent}</span></h2>
					<p>{data.edu.text}</p>
				</div>
				<div class="home-edu-action">
					<a href={data.edu.btnHref} class="btn btn-primary"><span>{data.edu.btnText}</span></a>
					<a href={data.edu.linkHref} class="home-edu-link">{data.edu.linkText}</a>
				</div>
			</div>
		</div>
	</section>

	<!-- Секция Кейсов (1 штука с детализацией) -->
	<section class="cases-section">
		<div class="container">
			<div class="section-header">
				<h2>{data.cases.titleLead} <span class="gradient-text">{data.cases.titleAccent}</span></h2>
				<p>{data.cases.sub}</p>
			</div>

			<div class="cases-grid">
				{data.cases.items.map((c) => (
					<div class="glass-card case-card">
						<div class="case-meta">{c.meta}<span class="case-date">{c.date}</span></div>
						<h3><a href={c.href} class="case-title-link">{c.title}</a></h3>
						<p>{c.desc}</p>
						<div class="case-result-badge">
							<span class="vs-label">Результат:</span>
							<span class="vs-win">{c.vsWin}</span>
							<span class="vs-sep">VS</span>
							<span class="vs-lose">{c.vsLose}</span>
						</div>
						<a href={c.href} class="case-link case-link-1">{c.linkText}</a>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Раздел: AI-инструменты по отраслям (без плашки, компактно) -->
	<section class="industries-section">
		<div class="container">
			<div class="section-header">
				<h2>{data.industries.titleLead} <span class="gradient-text">{data.industries.titleAccent}</span></h2>
				<p>{data.industries.sub}</p>
			</div>

			<div class="industries-grid-clean">
				{data.industries.items.map((ind) => (
					<div class="industry-clean-item glass-card">
						<div class="industry-clean-header">
							<div class="service-icon purple">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M3 21h18"></path><path d="M9 8h1"></path><path d="M9 12h1"></path><path d="M9 16h1"></path><path d="M14 8h1"></path><path d="M14 12h1"></path><path d="M14 16h1"></path><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path>
								</svg>
							</div>
							<h3><a href={ind.href} class="industry-title-link">{ind.title}</a></h3>
						</div>
						<p>{ind.desc}</p>
						<a href={ind.href} class="industry-clean-link industry-link-1">{ind.linkText}</a>
					</div>
				))}
			</div>
		</div>
	<!-- Большой экспертный SEO-текст -->
	<section class="seo-text-section">
		<div class="container">
			<div class="seo-text-content">
				<Fragment set:html={seo1} />

					<div class="team-table-wrap">
						<table class="team-table">
							<thead>
								<tr><th>{data.seoTables.teamH1}</th><th>{data.seoTables.teamH2}</th><th>{data.seoTables.teamH3}</th></tr>
							</thead>
							<tbody>
								{data.seoTables.team.map((r) => (
									<tr class={r.lead ? 'team-lead' : undefined}>
										<td>{r.who}</td>
										<td>{r.role}</td>
										<td>{r.resp}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>

					<Fragment set:html={seo2} />

					<div class="team-table-wrap svc-table-wrap">
						<table class="team-table svc-table">
							<thead>
								<tr><th>{data.seoTables.svcH1}</th><th>{data.seoTables.svcH2}</th><th>{data.seoTables.svcH3}</th></tr>
							</thead>
							<tbody>
								{data.seoTables.svc.map((s) => (
									<tr>
										<td>{s.service}<span class="svc-note">{s.note}</span></td>
										<td class="svc-old">{s.oldTime}<br /><span class="svc-price-old">{s.oldPrice}</span></td>
										<td class="svc-new">{s.newTime}<br /><span class="svc-price-new">{s.newPrice}</span></td>
									</tr>
								))}
							</tbody>
						</table>
					</div>

					<Fragment set:html={seo3} />
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="home-faq">
		<div class="container">
			<div class="faq-block">
				<h2>{data.faq.heading}</h2>
				{faqItems.map((item) => (
					<details class="faq-item">
						<summary>{item.q}</summary>
						<p>{item.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<!-- Форма обратной связи -->
	<section id="contact" class="contact-section">
		<div class="container">
			<div class="contact-wrapper glass-card">
				<div class="contact-header">
					<h2>{data.contact.titleLead} <span class="gradient-text">{data.contact.titleAccent}</span>?</h2>
					<p>{data.contact.sub}</p>
				</div>
				<form action="/send" method="POST" class="contact-form">
					<input type="hidden" name="_next" value="/thanks" />
					<div class="form-row">
						<div class="form-group">
							<label for="name">{data.contact.nameLabel}</label>
							<input type="text" id="name" name="name" required placeholder={data.contact.namePlaceholder} />
						</div>
						<div class="form-group">
							<label for="contact-field">{data.contact.contactLabel}</label>
							<input type="text" id="contact-field" name="contact" required placeholder={data.contact.contactPlaceholder} />
						</div>
					</div>
					<div class="form-group">
						<label for="message">{data.contact.msgLabel}</label>
						<textarea id="message" name="message" rows="4" placeholder={data.contact.msgPlaceholder}></textarea>
					</div>
					<button type="submit" class="btn btn-primary form-submit"><span>{data.contact.button}</span></button>
					<div class="privacy-agreement privacy-under-btn">
						<label class="checkbox-label">
							<input type="checkbox" name="agree" value="yes" required checked />
							<span class="privacy-text">Я согласен с <a href="/privacy" target="_blank">политикой конфиденциальности</a></span>
						</label>
					</div>
				</form>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Защита контента от перекрытия fixed-сферой */
	section {
		position: relative;
		z-index: 2;
	}
	/* Стили секции Hero */
	.hero {
		position: relative;
		padding: 120px 0 100px 0;
		overflow: hidden;
	}

	.hero-bg-glow {
		position: absolute;
		top: -200px;
		left: 50%;
		transform: translateX(-50%);
		width: 1000px;
		max-width: 100%;
		height: 500px;
		background: radial-gradient(circle, var(--accent-purple-glow) 0%, rgba(13,15,20,0) 100%);
		filter: blur(80px);
		pointer-events: none;
		z-index: 1;
	}

	.hero-container {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 60px;
		align-items: center;
		position: relative;
		z-index: 2;
	}

	.hero-content {
		max-width: 780px;
	}

	.hero h1 {
		font-size: 3.5rem;
		line-height: 1.15;
		letter-spacing: -1px;
		margin-bottom: 24px;
	}

	.hero-lead {
		font-size: 1.15rem;
		color: var(--text-muted);
		margin-bottom: 20px;
		line-height: 1.6;
	}

	.hero-experience {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text-main);
		margin-bottom: 30px;
		letter-spacing: -0.2px;
	}

	/* Хештеги AI-услуг */
	.hero-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin-bottom: 30px;
	}

	.hero-tag {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--glass-border);
		padding: 6px 14px;
		border-radius: 6px;
		font-family: 'Outfit', sans-serif;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--text-muted);
		cursor: pointer;
		user-select: none;
		transition: all var(--transition-fast);
		text-decoration: none;
		display: inline-block;
	}

	/* Теги-ссылки (есть реальный раздел) — лёгкий cyan-намёк на кликабельность */
	.hero-tag-link {
		color: var(--accent-cyan);
		border-color: rgba(6, 182, 212, 0.25);
	}
	.hero-tag-link:hover {
		border-color: var(--accent-cyan);
	}

	html.light .hero-tag {
		background: rgba(0, 0, 0, 0.02);
	}

	.hero-tag:hover {
		border-color: var(--accent-purple);
		color: #ffffff;
		transform: translateY(-1px);
	}

	html.light .hero-tag:hover {
		color: hsl(224, 25%, 12%);
	}

	/* Открытая форма в Hero */
	.hero-form {
		width: 100%;
		max-width: 820px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		align-items: flex-start;
	}

	.hero-form-row {
		display: flex;
		flex-direction: row;
		width: 100%;
		gap: 12px;
		align-items: stretch;
	}

	.hero-form-row input {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--glass-border);
		border-radius: 8px;
		padding: 12px 16px;
		color: #ffffff;
		font-family: inherit;
		font-size: 0.9rem;
		outline: none;
		flex: 1;
		min-width: 200px; /* Гарантирует одинаковый достаточный размер полей на десктопе */
		transition: border-color var(--transition-fast), background-color var(--transition-fast), color var(--transition-fast);
	}

	html.light .hero-form input {
		background: rgba(0, 0, 0, 0.02);
		border: 1px solid rgba(0, 0, 0, 0.06);
		color: hsl(224, 25%, 12%);
	}

	.hero-form input:focus {
		border-color: var(--accent-cyan);
	}

	/* Стили для чекбокса политики */
	.privacy-agreement {
		margin-top: 4px;
	}

	.hero-privacy {
		margin-left: 0;
		align-self: flex-end;
		margin-right: 4px;
	}

	.checkbox-label {
		display: flex;
		align-items: center;
		gap: 8px;
		cursor: pointer;
	}

	.checkbox-label input {
		width: 16px;
		height: 16px;
		margin-top: 1px;
		accent-color: var(--accent-cyan);
		cursor: pointer;
	}

	.privacy-text {
		font-size: 0.8rem;
		color: var(--text-muted);
		line-height: 1.3;
	}

	.privacy-text a {
		color: var(--accent-cyan);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.privacy-text a:hover {
		color: #ffffff;
	}

	html.light .privacy-text a:hover {
		color: hsl(224, 25%, 12%);
	}

	.hero-form-submit {
		padding: 12px 20px;
		font-size: 0.9rem;
		white-space: nowrap;
		flex-shrink: 0;
		height: 46px;
	}

	/* Анимация AI-сферы */
	.hero-visual {
		display: flex;
		justify-content: center;
		align-items: center;
		pointer-events: none;
	}

	/* Общие стили заголовков секций */
	.section-header {
		text-align: center;
		margin-bottom: 48px;
	}

	.section-header h2 {
		font-size: 2.5rem;
		margin-bottom: 16px;
		position: relative;
		display: inline-block;
	}

	.section-header h2::after {
		content: '';
		display: block;
		width: 64px;
		height: 3px;
		margin: 16px auto 0;
		border-radius: 3px;
		background: var(--grad-primary);
		box-shadow: 0 0 12px var(--accent-purple-glow);
	}

	.section-header p {
		color: var(--text-muted);
		font-size: 1.1rem;
		max-width: 700px;
		margin: 0 auto;
	}

	/* Кейсы */
	.cases-section {
		padding: 80px 0;
	}

	.cases-grid {
		display: grid;
		grid-template-columns: 1fr;
		max-width: 800px;
		margin: 0 auto;
		gap: 30px;
	}

	.case-card {
		padding: 40px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.case-meta {
		font-size: 0.85rem;
		color: var(--accent-cyan);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 1px;
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
	}

	.case-date {
		color: var(--text-dim);
		font-weight: 500;
		letter-spacing: 0.5px;
		padding-left: 12px;
		border-left: 1px solid var(--glass-border);
	}

	.case-card h3 {
		font-size: 1.5rem;
	}

	.case-title-link {
		color: inherit;
		text-decoration: none;
		transition: color var(--transition-fast);
	}
	.case-title-link:hover {
		color: var(--accent-cyan);
	}

	.case-card p {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
		flex-grow: 1;
	}

	.case-result-badge {
		background: rgba(6, 182, 212, 0.08);
		border: 1px solid rgba(6, 182, 212, 0.15);
		padding: 10px 16px;
		border-radius: 10px;
		font-weight: 600;
		font-size: 0.92rem;
		display: inline-flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 10px;
		align-self: flex-start;
	}

	.vs-label { color: var(--text-muted); }

	.vs-win {
		font-weight: 800;
		background: linear-gradient(120deg, var(--accent-cyan), var(--accent-purple));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.vs-sep {
		font-family: 'Outfit', sans-serif;
		font-weight: 800;
		font-size: 0.72rem;
		letter-spacing: 1px;
		color: #fff;
		background: var(--grad-primary);
		padding: 3px 10px;
		border-radius: 999px;
		box-shadow: 0 0 14px var(--accent-purple-glow);
	}

	.vs-lose {
		color: var(--text-dim);
		text-decoration: line-through;
		text-decoration-color: rgba(244, 63, 94, 0.55);
	}

	.case-link {
		font-weight: 700;
		font-size: 0.95rem;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 16px;
		align-self: flex-start;
		background: linear-gradient(120deg, var(--accent-cyan) 0%, var(--accent-purple) 50%, var(--accent-cyan) 100%);
		background-size: 200% auto;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: textShine 4s linear infinite;
		transition: transform var(--transition-fast);
	}

	.case-link.case-link-2 {
		animation-delay: 1.5s;
	}

	.case-card:hover .case-link {
		transform: translateX(6px);
	}

	/* Отраслевые решения (без плашек, компактно) */
	.industries-section {
		padding: 60px 0;
	}

	.industries-grid-clean {
		display: grid;
		grid-template-columns: 1fr;
		gap: 24px;
		margin-top: 20px;
		max-width: 600px;
		margin-inline: auto;
	}

	.industry-clean-item {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 32px;
		border-radius: 16px;
	}

	.industry-clean-header {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-bottom: 20px;
	}

	.industry-clean-header h3 {
		font-size: 1.4rem;
		font-weight: 700;
		margin: 0;
	}

	.industry-title-link {
		color: inherit;
		text-decoration: none;
		transition: color var(--transition-fast);
	}
	.industry-title-link:hover {
		color: var(--accent-cyan);
	}

	/* Иконка в карточках AI-инструментов — цветной бокс + ховер как на услугах */
	.industry-clean-header .service-icon {
		width: 44px;
		height: 44px;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: transform var(--transition-normal), box-shadow var(--transition-normal);
	}
	.industry-clean-header .service-icon.purple {
		background: rgba(147, 51, 234, 0.1);

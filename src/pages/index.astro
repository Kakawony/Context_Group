<!-- Скрипт следования AI-сферы за курсором в блоках Hero, SEO и формы -->
<script>
	const sphere = document.getElementById('interactive-sphere') as HTMLElement;
	const hero = document.querySelector('.hero') as HTMLElement;
	const seoSection = document.querySelector('.seo-text-section') as HTMLElement;
	const contactSection = document.querySelector('.contact-section') as HTMLElement;
	const heroForm = document.querySelector('.hero-form') as HTMLElement;
	const contactWrapper = document.querySelector('.contact-wrapper') as HTMLElement;
	
	if (sphere && hero && seoSection && contactSection) {
		let mouseX = window.innerWidth / 2;
		let mouseY = window.innerHeight / 2;
		let sphereX = mouseX - 150;
		let sphereY = mouseY - 150;
		let targetX = sphereX;
		let targetY = sphereY;
		let isInside = false;
		let initialized = false;
		
		const speed = 0.06; // Коэффициент сглаживания (lerp)
		
		window.addEventListener('mousemove', (e) => {
			const clientX = e.clientX;
			const clientY = e.clientY;
			
			const heroRect = hero.getBoundingClientRect();
			const seoRect = seoSection.getBoundingClientRect();
			const contactRect = contactSection.getBoundingClientRect();
			
			const inHero = (
				clientX >= heroRect.left && clientX <= heroRect.right &&
				clientY >= heroRect.top && clientY <= heroRect.bottom
			);
			const inSeo = (
				clientX >= seoRect.left && clientX <= seoRect.right &&
				clientY >= seoRect.top && clientY <= seoRect.bottom
			);
			const inContact = (
				clientX >= contactRect.left && clientX <= contactRect.right &&
				clientY >= contactRect.top && clientY <= contactRect.bottom
			);
			
			isInside = inHero || inSeo || inContact;
			
			targetX = clientX - 150;
			targetY = clientY - 150;
			
			if (!initialized && isInside) {
				sphereX = targetX;
				sphereY = targetY;
				initialized = true;
			}
			
			if (isInside) {
				sphere.style.opacity = '1';
			} else {
				sphere.style.opacity = '0';
			}
			
			// Проверяем нахождение над формами
			let overForm = false;
			if (heroForm) {
				const rect = heroForm.getBoundingClientRect();
				if (clientX >= rect.left && clientX <= rect.right && clientY >= rect.top && clientY <= rect.bottom) {
					overForm = true;
				}
			}
			if (contactWrapper) {
				const rect = contactWrapper.getBoundingClientRect();
				if (clientX >= rect.left && clientX <= rect.right && clientY >= rect.top && clientY <= rect.bottom) {
					overForm = true;
				}
			}
			
			if (overForm) {
				sphere.classList.add('at-form');
			} else {
				sphere.classList.remove('at-form');
			}
		});
		
		document.addEventListener('mouseleave', () => {
			sphere.style.opacity = '0';
			isInside = false;
		});
		
		document.addEventListener('mouseenter', () => {
			// Проверяется ли внутри активных зон при заходе мыши,
			// но это обновится при первом движении мыши (mousemove).
		});
		
		function animate() {
			sphereX += (targetX - sphereX) * speed;
			sphereY += (targetY - sphereY) * speed;
			
			const distX = targetX - sphereX;
			const distY = targetY - sphereY;
			const distance = Math.sqrt(distX * distX + distY * distY);
			
			const velocity = Math.min(distance * 0.05, 10);
			const blurVal = isInside ? velocity * 0.3 : 0;
			const scaleVal = isInside ? 1 + velocity * 0.01 : 1;
			
			sphere.style.transform = `translate3d(${sphereX}px, ${sphereY}px, 0) scale(${scaleVal})`;
			
			const core = sphere.querySelector('.ai-sphere-core') as HTMLElement;
			if (core) {
				core.style.filter = `blur(${10 + blurVal}px)`;
			}
			
			requestAnimationFrame(animate);
		}
		
		animate();
	}
</script>

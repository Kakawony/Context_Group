---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AiSphere from '../components/AiSphere.astro';
import TeamSection from '../components/TeamSection.astro';

import data from '../content/pages/ai-real-estate/index.json';
import { ICONS } from '../data/icons';
import Markdoc from '@markdoc/markdoc';
import seoRichRaw from '../content/pages/ai-real-estate/index/seoRich.mdoc?raw';

// Получаем статьи блога с тегом из JSON
const rawPosts = Object.values(import.meta.glob('./blog/*.md', { eager: true })) as any[];
const realEstatePosts = rawPosts.filter(post =>
	post.frontmatter.tags && post.frontmatter.tags.includes(data.blogTag)
);

// FAQ — единый источник для разметки и микроразметки FAQPage (Schema.org)
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: data.faqItems.map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: { '@type': 'Answer', text: item.a },
	})),
};

const seoRichHtml = Markdoc.renderers.html(Markdoc.transform(Markdoc.parse(seoRichRaw)));
---

<Layout title={data.title} description={data.description}>
	<script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
	<AiSphere alwaysVisible={true} scale={0.5} hideOnSelector=".industry-seo-section" />
	
	<section class="industry-hero">
		<div class="hero-glow"></div>
		<div class="container">
			<Breadcrumbs items={[{ label: data.breadcrumb }]} />
			<div class="badge">{data.heroBadge}</div>
			<h1>{data.heroTitleLead}<span class="gradient-text">{data.heroTitleAccent}</span></h1>
			<p class="hero-desc">
				{data.heroDesc}
			</p>
		</div>
	</section>

	<!-- Картотека AI-инструментов -->
	<section class="tools-catalog">
		<div class="container">
			<div class="tools-grid">
				{data.tools.map((tool) => (
					<div class="glass-card tool-card">
						<div class="tool-header">
							<div class={`service-icon ${tool.iconClass}`} style="transform: scale(0.8); margin-right: -4px;" set:html={ICONS[tool.icon]}></div>
							<h3><a href={tool.link} class="tool-title-link">{tool.title}</a></h3>
						</div>
						<div class="tool-code-wrapper">
							<span class="tool-status-code">{tool.code}</span>
						</div>
						<p class="tool-desc">{tool.desc}</p>
						<div class="tool-price">
							{tool.prices.map((p) => (
								<span class="tool-price-row"><span class="tp-label">{p.label}</span><span class="tp-val" set:html={p.value}></span></span>
							))}
						</div>
						<a href={tool.link} class="prompt-more-link">{tool.linkText} &rarr;</a>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Экспертный SEO-текст -->
	<section class="industry-seo-section">
		<div class="container">
			<div class="seo-text-block-clean">
				<h2>{data.seoTitle}</h2>
				<div class="seo-text-content">
					<Fragment set:html={seoRichHtml} />
				</div>
			</div>
		</div>
	</section>

	<!-- FAQ -->
	<section class="industry-faq">
		<div class="container">
			<div class="faq-block">
				<h2>{data.faqTitle}</h2>
				{data.faqItems.map((item) => (
					<details class="faq-item">
						<summary>{item.q}</summary>
						<p>{item.a}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<!-- Дополнительные материалы -->
	{realEstatePosts.length > 0 && (
		<section class="industry-blog">
			<div class="container">
				<div class="glass-card blog-section-card">
					<div class="blog-section-header">
						<h2>{data.blogTitleLead}<span class="gradient-text">{data.blogTitleAccent}</span></h2>
						<p>{data.blogSub}</p>
					</div>
					
					<div class="blog-grid">
						{realEstatePosts.map((post) => (
							<a href={post.url} class="blog-card-inline">
								<div class="blog-card-meta">
									<span class="category-tag">{post.frontmatter.category}</span>
									<span class="meta-separator">&bull;</span>
									<span>{post.frontmatter.date}</span>
								</div>
								<h3>{post.frontmatter.title}</h3>
								<p>{post.frontmatter.description}</p>
								<span class="read-more">Читать &rarr;</span>
							</a>
						))}
					</div>
				</div>
			</div>
		</section>
	)}

	<!-- Над проектом будут работать -->
	<section class="team-section">
		<div class="container">
			<TeamSection />
		</div>
	</section>
</Layout>

<style>
	.industry-hero {
		position: relative;
		padding: 60px 0 30px 0;
		overflow: hidden;
		text-align: left;
	}

	.hero-glow {
		position: absolute;
		top: -150px;
		left: -10%;
		width: 800px;
		height: 400px;
		background: radial-gradient(circle, var(--accent-cyan-glow) 0%, rgba(13,15,20,0) 100%);
		filter: blur(80px);
		pointer-events: none;
		z-index: 1;
	}

	.industry-hero h1 {
		font-size: 2.8rem;
		line-height: 1.15;
		margin-bottom: 24px;
		letter-spacing: -1px;
		position: relative;
		z-index: 2;
	}

	.hero-desc {
		color: var(--text-muted);
		font-size: 1.15rem;
		max-width: 700px;
		margin: 0;
		line-height: 1.6;
		position: relative;
		z-index: 2;
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: rgba(6, 182, 212, 0.1);
		border: 1px solid rgba(6, 182, 212, 0.2);
		padding: 6px 16px;
		border-radius: 9999px;
		font-size: 0.85rem;
		font-family: 'Outfit', sans-serif;
		font-weight: 500;
		color: var(--accent-cyan);
		margin-bottom: 24px;
		position: relative;
		z-index: 2;
	}

	/* Картотека */
	.tools-catalog {
		padding: 10px 0 40px 0;
	}

	.tools-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}

	.tool-card {
		padding: 16px;
		display: flex;
		flex-direction: column;
		gap: 12px;
		border-radius: 12px;
		width: 280px;
	}

	.tool-title-link {
		color: var(--text-main);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.tool-title-link:hover {
		color: var(--accent-cyan);
	}

	.tool-header {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	/* Стили для иконок (копируем логику с главной) */
	.service-icon {
		width: 48px;
		height: 48px;
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #ffffff;
		flex-shrink: 0;
	}

	.service-icon.purple {
		background: linear-gradient(135deg, rgba(168, 85, 247, 0.2) 0%, rgba(168, 85, 247, 0.05) 100%);
		border: 1px solid rgba(168, 85, 247, 0.3);
		box-shadow: 0 0 20px rgba(168, 85, 247, 0.15);
		color: #c084fc;
	}

	.service-icon.cyan {
		background: linear-gradient(135deg, rgba(6, 182, 212, 0.2) 0%, rgba(6, 182, 212, 0.05) 100%);
		border: 1px solid rgba(6, 182, 212, 0.3);
		box-shadow: 0 0 20px rgba(6, 182, 212, 0.15);
		color: #22d3ee;
	}

	.tool-card h3 {
		font-size: 1.05rem;
		margin: 0;
		line-height: 1.3;
	}

	.tool-code-wrapper {
		margin: 4px 0;
	}

	.tool-status-code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.75rem;
		color: var(--text-dim);
		background: rgba(255, 255, 255, 0.04);
		padding: 4px 8px;
		border-radius: 6px;
		letter-spacing: -0.2px;
		display: inline-block;
	}

	html.light .tool-status-code {
		background: rgba(0, 0, 0, 0.03);
	}

	.tool-desc {
		color: var(--text-muted);
		font-size: 0.85rem;
		line-height: 1.4;
		margin: 4px 0 8px 0;
	}

	.tool-price {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin: 0 0 10px 0;
		padding-top: 10px;
		border-top: 1px solid var(--glass-border);
	}

	.tool-price-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 10px;
		font-size: 0.82rem;
	}

	.tp-label {
		color: var(--text-dim);
	}

	.tp-val {
		color: var(--accent-cyan);
		font-weight: 700;
		white-space: nowrap;
	}

	.prompt-more-link {
		font-weight: 700;
		font-size: 0.85rem;
		align-self: flex-start;
		display: inline-flex;
		align-items: center;
		gap: 4px;
		background: linear-gradient(120deg, #38bdf8 0%, #f43f5e 50%, #38bdf8 100%);
		background-size: 200% auto;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: textShine 4s linear infinite;
		transition: transform var(--transition-fast);
	}

	.tool-card:hover .prompt-more-link {
		transform: translateX(4px);
	}

	/* SEO-блок */
	.industry-seo-section {
		padding: 40px 0;
	}

	.seo-text-block-clean :global(h3) {
		font-size: 1.3rem;
		margin: 28px 0 12px 0;
		color: var(--text-main);
		position: relative;
		padding-left: 18px;
	}
	.seo-text-block-clean :global(h3::before) {
		content: '';
		position: absolute;
		left: 0;
		top: 0.42em;
		width: 9px;
		height: 9px;
		border-radius: 2px;
		background: var(--accent-cyan);
		box-shadow: 0 0 10px var(--accent-cyan-glow);
	}

	.seo-text-block-clean h2 {
		font-size: 2rem;
		margin-bottom: 24px;
		line-height: 1.3;
		position: relative;
		padding-left: 22px;
	}
	.seo-text-block-clean h2::before {
		content: '';
		position: absolute;
		left: 0;
		top: 5px;
		bottom: 5px;
		width: 4px;
		border-radius: 4px;
		background: var(--grad-primary);
		box-shadow: 0 0 12px var(--accent-purple-glow);
	}

	/* SEO-таблица команды (как на главной) */
	.team-table-wrap {
		margin: 28px 0 8px;
		overflow-x: auto;
		border: 1px solid var(--glass-border);
		border-radius: 14px;
		background: rgba(255, 255, 255, 0.015);
	}
	html.light .team-table-wrap { background: rgba(0, 0, 0, 0.015); }

	.team-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
		min-width: 520px;
	}
	.team-table th {
		text-align: left;
		padding: 14px 18px;
		font-family: 'Outfit', sans-serif;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: var(--accent-cyan);
		border-bottom: 1px solid var(--glass-border);
	}
	.team-table td {
		padding: 13px 18px;
		color: var(--text-muted);
		border-bottom: 1px solid rgba(255, 255, 255, 0.04);
		line-height: 1.5;
		vertical-align: top;
	}
	html.light .team-table td { border-bottom: 1px solid rgba(0, 0, 0, 0.05); }
	.team-table tbody tr:last-child td { border-bottom: none; }
	.team-table td:first-child {
		font-weight: 600;
		color: var(--text-main);
		white-space: nowrap;
	}
	.team-table tr.team-lead td { background: rgba(147, 51, 234, 0.07); }
	.team-table tr.team-lead td:first-child {
		background: linear-gradient(120deg, var(--accent-cyan), var(--accent-purple));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.seo-text-content {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.seo-text-content :global(p) {
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1.7;
	}
	.seo-text-content :global(a) {
		color: var(--accent-cyan);
		text-decoration: underline;
		text-underline-offset: 2px;
		font-weight: 600;
	}
	.seo-text-content :global(a:hover) { color: var(--accent-purple); }
	.seo-text-content :global(strong) { color: #ffffff; font-weight: 600; }

	.seo-text-content code {
		background: rgba(255, 255, 255, 0.05);
		padding: 2px 6px;
		border-radius: 4px;
		font-family: monospace;
		color: var(--accent-cyan);
	}

	html.light .seo-text-content code {
		background: rgba(0, 0, 0, 0.04);
	}

	/* FAQ */
	.industry-faq { padding: 20px 0 40px 0; }
	.faq-block h2 { font-size: 2rem; margin-bottom: 24px; line-height: 1.3; }
	.faq-item {
		border: 1px solid var(--glass-border);
		border-radius: 12px;
		padding: 18px 22px;
		margin-bottom: 12px;
		background: rgba(255,255,255,0.015);
	}
	html.light .faq-item { background: rgba(0,0,0,0.015); }
	.faq-item summary {
		cursor: pointer;
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--text-main);
		list-style: none;
		display: flex;
		justify-content: space-between;
		gap: 12px;
	}
	.faq-item summary::after { content: '+'; color: var(--accent-cyan); font-size: 1.4rem; line-height: 1; }
	.faq-item[open] summary::after { content: '−'; }
	.faq-item p { margin-top: 12px; color: var(--text-muted); line-height: 1.65; font-size: 0.98rem; }

	/* Блог */
	.industry-blog {
		padding: 40px 0 60px 0;
	}

	.blog-section-card {
		padding: 40px;
	}

	.blog-section-header {
		text-align: left;
		margin-bottom: 30px;
	}

	.blog-section-header h2 {
		font-size: 2rem;
		margin-bottom: 8px;
	}

	.blog-section-header p {
		color: var(--text-muted);
		font-size: 1rem;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 16px;
	}

	.blog-card-inline {
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding: 20px;
		background: rgba(255, 255, 255, 0.015);
		border: 1px solid rgba(255, 255, 255, 0.04);
		border-radius: 12px;
		transition: border-color var(--transition-fast), background-color var(--transition-fast), transform var(--transition-fast);
	}

	html.light .blog-card-inline {
		background: rgba(0, 0, 0, 0.015);
		border: 1px solid rgba(0, 0, 0, 0.03);
	}

	.blog-card-inline:hover {
		border-color: rgba(255, 255, 255, 0.1);
		background: rgba(255, 255, 255, 0.03);
		transform: translateY(-2px);
	}

	html.light .blog-card-inline:hover {
		border-color: rgba(0, 0, 0, 0.06);
		background: rgba(0, 0, 0, 0.025);
	}

	.blog-card-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.75rem;
		color: var(--text-dim);
	}

	.category-tag {
		background: rgba(6, 182, 212, 0.1);
		border: 1px solid rgba(6, 182, 212, 0.2);
		color: var(--accent-cyan);
		padding: 2px 8px;
		border-radius: 9999px;
		font-weight: 500;
	}

	.meta-separator {
		color: var(--text-dim);
	}

	.blog-card-inline h3 {
		font-size: 1.05rem;
		line-height: 1.35;
	}

	.blog-card-inline p {
		color: var(--text-muted);
		font-size: 0.85rem;
		line-height: 1.5;
		flex-grow: 1;
	}

	.read-more {
		color: var(--accent-cyan);
		font-weight: 600;
		font-size: 0.85rem;
		margin-top: auto;
	}

	/* Над проектом будут работать */
	.team-section {
		padding: 40px 0 80px 0;
	}

	@keyframes textShine {
		0% {
			background-position: 0% center;
		}
		100% {
			background-position: 200% center;
		}
	}

	/* Адаптивность */
	@media (max-width: 992px) {
		.tools-grid {
			grid-template-columns: repeat(2, 1fr);
		}
		.blog-section-card {
			padding: 30px 20px;
		}
		.blog-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.industry-hero h1 {
			font-size: 2.2rem;
		}
		.blog-section-header h2 {
			font-size: 1.8rem;
		}
		.tool-card {
			width: 100%;
		}
		.blog-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

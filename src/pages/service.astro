---
import Layout from '../layouts/Layout.astro';
import AiSphere from '../components/AiSphere.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BlogGrid from '../components/BlogGrid.astro';
import TeamSection from '../components/TeamSection.astro';

const title = "AI Ассистент для отдела продаж | Context Group";
const description = "Внедрение умного AI-ассистента для автоматизации продаж и общения с клиентами. Разработка под ключ, интеграция с CRM.";
---

<Layout title={title} description={description}>
	<!-- Шарик прячем на секции команды, так как там есть свои лица/интерфейсы -->
	<AiSphere alwaysVisible={true} scale={0.5} hideOnSelector=".team-section" />

	<div class="page-container">
		<Breadcrumbs items={[
			{ label: 'Услуги', href: '/#services' },
			{ label: 'AI Ассистент продаж', href: '/service' }
		]} />

		<!-- Hero Section с формой -->
		<section class="service-hero">
			<div class="container hero-grid">
				<div class="hero-content">
					<h1>Внедрение <span class="gradient-text">AI-Ассистента</span> в отдел продаж</h1>
					<p class="hero-description">
						Автоматизируйте квалификацию лидов, ответы на частые вопросы и запись на встречи. Наш AI-бот общается как живой менеджер, работает 24/7 и интегрируется напрямую в вашу CRM (amoCRM, Bitrix24) и мессенджеры.
					</p>
					<ul class="hero-features">
						<li>✓ Отвечает за 3 секунды</li>
						<li>✓ Знает базу знаний вашей компании</li>
						<li>✓ Увеличивает конверсию из лида во встречу на 35%</li>
					</ul>
				</div>
				<div class="hero-form-wrapper">
					<div class="glass-card lead-form">
						<h3>Получить расчет</h3>
						<p>Оставьте заявку, и мы свяжемся для обсуждения проекта</p>
						<form class="contact-form" action="https://formspree.io/f/xbjnqpyz" method="POST">
							<div class="form-group">
								<input type="text" name="name" placeholder="Ваше Имя" required />
							</div>
							<div class="form-group">
								<input type="text" name="phone_or_tg" placeholder="Телефон или Telegram" required />
							</div>
							<button type="submit" class="btn btn-primary form-submit"><span>Оставить заявку</span></button>
							<p class="privacy-note">Нажимая кнопку, вы соглашаетесь с политикой конфиденциальности.</p>
						</form>
					</div>
				</div>
			</div>
		</section>

		<!-- Секция с Кейсами -->
		<section class="cases-section">
			<div class="container">
				<div class="section-header">
					<h2>Примеры <span class="gradient-text">внедрений</span></h2>
					<p>Как работает AI-ассистент в реальном бизнесе</p>
				</div>
				<div class="cases-grid">
					<!-- Кейс 1 -->
					<div class="glass-card case-card">
						<div class="case-meta">Недвижимость</div>
						<h3>Автоматизация показов для агентства</h3>
						<p>Разработали бота, который сам квалифицирует покупателя по бюджету и району, а затем предлагает свободные слоты для просмотра квартир прямо в WhatsApp.</p>
						<div class="case-result-badge">Результат: +40% целевых лидов, работает 24/7</div>
						<a href="/blog/seo-arhitector-property" class="case-link case-link-1">Читать подробнее &rarr;</a>
					</div>
					<!-- Кейс 2 -->
					<div class="glass-card case-card">
						<div class="case-meta">EdTech</div>
						<h3>Бот-куратор для онлайн-школы</h3>
						<p>AI-ассистент, обученный на 1000+ методичек. Отвечает на вопросы студентов по домашним заданиям и автоматически проверяет тесты, снимая нагрузку с живых кураторов.</p>
						<div class="case-result-badge">Результат: -60% нагрузка на саппорт, ответ за 2 мин</div>
						<a href="/blog/avtootvety-i-boti-ekonomiya-fot" class="case-link case-link-2">Читать подробнее &rarr;</a>
					</div>
				</div>
			</div>
		</section>

		<!-- SEO Текст 1 -->
		<section class="seo-intro-section">
			<div class="container">
				<div class="seo-text-wrapper">
					<h2>Зачем бизнесу внедрять умного бота?</h2>
					<p>Современные решения на базе генеративного искусственного интеллекта кардинально отличаются от старых кнопочных ботов. Нейросеть понимает контекст диалога, исправляет опечатки пользователя и ведет осмысленную беседу, опираясь строго на базу знаний вашей компании. Это позволяет не только экономить на фонде оплаты труда, но и исключить человеческий фактор: бот никогда не грубит, не уходит на обед и мгновенно отвечает клиентам даже глубокой ночью, повышая лояльность аудитории.</p>
				</div>
			</div>
		</section>

		<!-- Pricing Section -->
		<section class="pricing-section">
			<div class="container">
				<div class="section-header">
					<h2>Варианты <span class="gradient-text">сотрудничества</span></h2>
				</div>
				<div class="pricing-grid">
					<!-- Тариф 1 -->
					<div class="glass-card pricing-card">
						<div class="pricing-header">
							<h3>Промпты + Инструкции</h3>
							<p>Для самостоятельного внедрения</p>
						</div>
						<div class="pricing-price">
							<span class="currency">₽</span>
							<span class="amount">49 000</span>
						</div>
						<ul class="pricing-features">
							<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Готовые системные промпты для роли</li>
							<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Инструкция по сборке в Make/n8n</li>
							<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Рекомендации по формату базы знаний</li>
							<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 1 час консультации</li>
						</ul>
						<form class="pricing-form" action="https://formspree.io/f/xbjnqpyz" method="POST">
							<input type="text" name="name" placeholder="Ваше Имя" required />
							<input type="text" name="phone_or_tg" placeholder="Телефон или Telegram" required />
							<button type="submit" class="btn btn-outline pricing-btn">Оставить заявку</button>
						</form>
					</div>
					
					<!-- Тариф 2 -->
					<div class="glass-card pricing-card popular">
						<div class="pricing-header">
							<h3>Внедрение под ключ</h3>
							<p>Сделаем всё за вас и интегрируем в процессы</p>
						</div>
						<div class="pricing-price">
							<span class="currency">от ₽</span>
							<span class="amount">150 000</span>
						</div>
						<ul class="pricing-features">
							<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Аудит процессов и сбор базы знаний</li>
							<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Разработка и тестирование бота</li>
							<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> Интеграция с CRM и мессенджерами</li>
							<li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg> 1 месяц технической поддержки</li>
						</ul>
						<form class="pricing-form" action="https://formspree.io/f/xbjnqpyz" method="POST">
							<input type="text" name="name" placeholder="Ваше Имя" required />
							<input type="text" name="phone_or_tg" placeholder="Телефон или Telegram" required />
							<button type="submit" class="btn btn-primary pricing-btn"><span>Оставить заявку</span></button>
						</form>
					</div>
				</div>
			</div>
		</section>



		<!-- SEO Текст 2 -->
		<section class="seo-detailed-section">
			<div class="container">
				<div class="seo-text-wrapper">
					<h2>Как происходит разработка и внедрение AI-ассистента</h2>
					<p>Процесс интеграции искусственного интеллекта в бизнес-процессы требует системного подхода. Мы не просто подключаем ChatGPT к вашему Telegram, мы создаем полноценного сотрудника, который знает все регламенты вашей компании. На первом этапе мы проводим глубокий аудит: анализируем частые вопросы клиентов, структуру диалогов лучших менеджеров и собираем единую базу знаний.</p>
					
					<h3>Интеграция с инфраструктурой</h3>
					<p>Для того чтобы бот приносил реальную пользу, он должен быть интегрирован в ваши текущие IT-решения. Мы настраиваем бесшовную связь с amoCRM, Bitrix24 или самописными системами. Бот самостоятельно создает карточки сделок, обогащает их контактными данными, пишет саммари разговора и ставит задачи менеджерам на следующий шаг воронки.</p>
					
					<h3>Безопасность и контроль галлюцинаций</h3>
					<p>Главный страх бизнеса — что нейросеть начнет придумывать несуществующие акции или грубить клиентам. Чтобы этого избежать, мы используем строгие системные промпты (system prompts) и RAG-архитектуру (Retrieval-Augmented Generation). Бот получает доступ только к утвержденной информации и, если не знает ответа, аккуратно переводит диалог на живого оператора. Все диалоги логируются и доступны для анализа в едином окне, что позволяет непрерывно дообучать ассистента и повышать качество обслуживания.</p>
				</div>
			</div>
		</section>

		<!-- Team Section (Под тарифами) -->
		<section id="contact-manager" class="team-section">
			<div class="container">
				<TeamSection />
			</div>
		</section>

		<!-- Перелинковка с блогом -->
		<section class="related-posts-section">
			<div class="container">
				<div class="section-header">
					<h2>Дополнительные материалы в <span class="gradient-text">информационном Hub</span></h2>
				</div>
				<BlogGrid limit={4} />
			</div>
		</section>

	</div>
</Layout>

<style>
	.page-container {
		padding-top: 100px;
	}

	/* Hero Section */
	.service-hero {
		padding: 40px 0 80px 0;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 400px;
		gap: 60px;
		align-items: center;
	}

	.badge {
		display: inline-block;
		padding: 6px 12px;
		background: rgba(147, 51, 234, 0.1);
		border: 1px solid rgba(147, 51, 234, 0.3);
		color: var(--accent-purple);
		border-radius: 20px;
		font-size: 0.85rem;
		font-weight: 600;
		margin-bottom: 20px;
	}

	.hero-content h1 {
		font-size: 3rem;
		margin-bottom: 24px;
		line-height: 1.2;
	}

	.hero-description {
		font-size: 1.15rem;
		color: var(--text-muted);
		line-height: 1.6;
		margin-bottom: 30px;
	}

	.hero-features {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.hero-features li {
		font-size: 1.05rem;
		font-weight: 500;
		display: flex;
		align-items: center;
		gap: 8px;
		color: #e2e8f0;
	}
	
	html.light .hero-features li {
		color: hsl(224, 25%, 12%);
	}

	/* Hero Form */
	.lead-form {
		padding: 30px;
		border-radius: 16px;
	}

	.lead-form h3 {
		font-size: 1.4rem;
		margin-bottom: 8px;
		text-align: center;
	}

	.lead-form p {
		font-size: 0.9rem;
		color: var(--text-muted);
		margin-bottom: 24px;
		text-align: center;
		line-height: 1.4;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.form-group input {
		width: 100%;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 8px;
		padding: 12px 16px;
		color: #ffffff;
		font-family: inherit;
		outline: none;
		transition: border-color var(--transition-fast);
	}

	html.light .form-group input {
		background: rgba(0, 0, 0, 0.02);
		border: 1px solid rgba(0, 0, 0, 0.06);
		color: hsl(224, 25%, 12%);
	}

	.form-group input:focus {
		border-color: var(--accent-cyan);
	}

	.form-submit {
		width: 100%;
		justify-content: center;
		margin-top: 8px;
	}

	.privacy-note {
		font-size: 0.75rem !important;
		margin-bottom: 0 !important;
		opacity: 0.7;
	}

	/* Кейсы */
	.cases-section {
		padding: 60px 0;
	}

	.section-header {
		text-align: center;
		margin-bottom: 40px;
	}

	.section-header h2 {
		font-size: 2.2rem;
		margin-bottom: 12px;
	}

	.section-header p {
		color: var(--text-muted);
		font-size: 1.05rem;
	}

	.cases-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
	}

	.case-card {
		padding: 40px;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.case-meta {
		font-size: 0.85rem;
		color: var(--accent-cyan);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.case-card h3 {
		font-size: 1.5rem;
	}

	.case-card p {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.6;
		flex-grow: 1;
	}

	.case-result-badge {
		background: rgba(6, 182, 212, 0.08);
		border: 1px solid rgba(6, 182, 212, 0.15);
		color: var(--accent-cyan);
		padding: 10px 16px;
		border-radius: 8px;
		font-weight: 600;
		font-size: 0.9rem;
		display: inline-block;
		margin-top: 10px;
		align-self: flex-start;
	}

	.case-link {
		font-weight: 700;
		font-size: 0.95rem;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 16px;
		align-self: flex-start;
		background: linear-gradient(120deg, var(--accent-cyan) 0%, var(--accent-purple) 50%, var(--accent-cyan) 100%);
		background-size: 200% auto;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: textShine 4s linear infinite;
		transition: transform var(--transition-fast);
	}

	.case-link.case-link-2 {
		animation-delay: 1.5s;
	}

	.case-card:hover .case-link {
		transform: translateX(6px);
	}

	/* SEO Intro */
	.seo-intro-section {
		padding: 40px 0;
	}

	.seo-text-wrapper {
		max-width: 800px;
		margin: 0 auto;
	}

	.seo-text-wrapper h2 {
		font-size: 1.8rem;
		margin-bottom: 16px;
	}

	.seo-text-wrapper p {
		color: var(--text-muted);
		line-height: 1.6;
		font-size: 1.05rem;
	}

	/* Pricing */
	.pricing-section {
		padding: 60px 0;
	}

	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 30px;
		max-width: 900px;
		margin: 0 auto;
	}

	.pricing-card {
		padding: 40px;
		display: flex;
		flex-direction: column;
		position: relative;
		overflow: hidden;
	}

	.pricing-card.popular {
		background: rgba(147, 51, 234, 0.05);
		border-color: rgba(147, 51, 234, 0.5);
		box-shadow: 0 8px 32px rgba(147, 51, 234, 0.15);
	}

	html.light .pricing-card.popular {
		background: rgba(147, 51, 234, 0.05);
		border-color: rgba(147, 51, 234, 0.3);
	}

	.pricing-header {
		margin-bottom: 24px;
	}

	.pricing-header h3 {
		font-size: 1.5rem;
		margin-bottom: 8px;
	}

	.pricing-header p {
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.pricing-price {
		display: flex;
		align-items: baseline;
		gap: 8px;
		margin-bottom: 30px;
	}

	.currency {
		font-size: 1.2rem;
		color: var(--text-muted);
	}

	.amount {
		font-size: 2.5rem;
		font-weight: 800;
	}

	.pricing-features {
		list-style: none;
		padding: 0;
		margin-bottom: 40px;
		flex-grow: 1;
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.pricing-features li {
		display: flex;
		align-items: flex-start;
		gap: 12px;
		color: var(--text-muted);
		line-height: 1.4;
	}

	.pricing-features svg {
		width: 18px;
		height: 18px;
		color: var(--accent-cyan);
		flex-shrink: 0;
		margin-top: 2px;
	}

	.pricing-form {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-top: 20px;
	}

	.pricing-form input {
		width: 100%;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 8px;
		padding: 12px 16px;
		color: #ffffff;
		font-family: inherit;
		outline: none;
		transition: border-color var(--transition-fast);
	}

	html.light .pricing-form input {
		background: rgba(0, 0, 0, 0.02);
		border: 1px solid rgba(0, 0, 0, 0.06);
		color: hsl(224, 25%, 12%);
	}

	.pricing-form input:focus {
		border-color: var(--accent-cyan);
	}

	.pricing-btn {
		width: 100%;
		justify-content: center;
		margin-top: 8px;
		transition: all 0.3s ease !important;
	}

	.pricing-form button.btn-outline {
		background: #f1f5f9;
		color: #0f172a;
		border: none;
	}
	
	html.light .pricing-form button.btn-outline {
		background: #f1f5f9;
		color: #0f172a;
	}

	html.dark .pricing-form button.btn-outline {
		background: rgba(255,255,255,0.1);
		color: #fff;
	}

	.pricing-btn:hover {
		transform: translateY(-2px) !important;
		box-shadow: 0 4px 15px rgba(147, 51, 234, 0.4) !important;
	}
	
	.pricing-form button.btn-outline:hover,
	html.light .pricing-form button.btn-outline:hover,
	html.dark .pricing-form button.btn-outline:hover {
		background: var(--accent-purple) !important;
		color: #ffffff !important;
	}

	/* Team Section */
	.team-section {
		padding: 40px 0 80px 0;
	}



	/* SEO Detailed */
	.seo-detailed-section {
		padding: 40px 0;
	}

	.seo-detailed-section .seo-text-wrapper {
		max-width: 800px;
		margin: 0 auto;
	}

	.seo-detailed-section h2 {
		font-size: 2rem;
		margin-bottom: 24px;
	}

	.seo-detailed-section h3 {
		font-size: 1.4rem;
		margin-top: 32px;
		margin-bottom: 16px;
		color: #e2e8f0;
	}
	
	html.light .seo-detailed-section h3 {
		color: hsl(224, 25%, 12%);
	}

	.seo-detailed-section p {
		color: var(--text-muted);
		line-height: 1.7;
		margin-bottom: 16px;
		font-size: 1.05rem;
	}

	/* Related Posts */
	.related-posts-section {
		padding: 60px 0 100px 0;
	}

	.blog-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 24px;
	}

	.blog-section-card {
		padding: 30px;
		display: flex;
		flex-direction: column;
	}

	.blog-meta {
		margin-bottom: 16px;
	}

	.blog-tag {
		background: rgba(147, 51, 234, 0.1);
		color: var(--accent-purple);
		padding: 4px 12px;
		border-radius: 20px;

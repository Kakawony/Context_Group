---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<Layout title="Страница не найдена (404) | Context Group" description="Запрашиваемая страница не существует или была перемещена." noindex={true}>
	<section class="error-section">
		<div class="error-glow"></div>
		<div class="error-layout-container">
			<Breadcrumbs items={[{ label: '404' }]} />
			<div class="container error-container">
				<div class="glass-card error-card">
				<div class="error-code">404</div>
				<h1>Страница не найдена</h1>
				<p>Похоже, эта ссылка повреждена или страница была удалена. Но наш искусственный интеллект готов направить вас в нужное русло.</p>
				<div class="error-actions">
					<a href="/" class="btn btn-primary"><span>На главную</span></a>
					<a href="/blog" class="btn btn-secondary">Блог</a>
				</div>
			</div>
		</div>
		</div>
	</section>
</Layout>

<style>
	.error-layout-container {
		width: 100%;
		display: flex;
		flex-direction: column;
		position: relative;
		z-index: 2;
	}

	.error-section {
		position: relative;
		min-height: calc(100vh - 200px);
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 80px 0;
		overflow: hidden;
	}

	.error-glow {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 600px;
		height: 600px;
		background: radial-gradient(circle, var(--accent-purple-glow) 0%, rgba(13,15,20,0) 100%);
		filter: blur(80px);
		pointer-events: none;
		z-index: 1;
	}

	.error-container {
		position: relative;
		z-index: 2;
		display: flex;
		justify-content: center;
	}

	.error-card {
		max-width: 600px;
		padding: 60px 40px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 24px;
	}

	.error-code {
		font-family: 'Outfit', sans-serif;
		font-size: 6rem;
		font-weight: 800;
		line-height: 1;
		background: var(--grad-primary);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		letter-spacing: -2px;
		animation: pulseGlow 3s infinite alternate;
	}

	.error-card h1 {
		font-size: 2.5rem;
	}

	.error-card p {
		color: var(--text-muted);
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.error-actions {
		display: flex;
		gap: 16px;
		margin-top: 12px;
		flex-wrap: wrap;
		justify-content: center;
	}

	@keyframes pulseGlow {
		0% { filter: drop-shadow(0 0 5px rgba(147, 51, 234, 0.2)); }
		100% { filter: drop-shadow(0 0 20px rgba(147, 51, 234, 0.6)); }
	}

	@media (max-width: 576px) {
		.error-card {
			padding: 40px 20px;
		}
		.error-code {
			font-size: 4.5rem;
		}
		.error-card h1 {
			font-size: 2rem;
		}
		.error-actions {
			flex-direction: column;
			width: 100%;
		}
		.error-actions .btn {
			width: 100%;
		}
	}
</style>

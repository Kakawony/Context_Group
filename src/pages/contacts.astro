---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import data from '../content/pages/contacts/index.json';
import { ICONS } from '../data/icons';
---

<Layout title={data.title} description={data.description}>
	<section class="contacts-page">
		<div class="contacts-glow"></div>
		<Breadcrumbs items={[{ label: data.breadcrumb }]} />
		<div class="container contacts-container">
			<!-- Колонка с информацией о Виталии Лапине -->
			<div class="profile-card glass-card">
				<div class="profile-header">
					<!-- Декоративный аватар с AI-эффектом -->
					<div class="avatar-wrapper">
						<div class="avatar-placeholder">
							<img src={data.profile.avatar} alt={data.profile.name} class="avatar-photo" width="80" height="80" />
						</div>
						<div class="avatar-glow-ring"></div>
					</div>
					<div class="profile-title">
						<h1>{data.profile.name}</h1>
						<p class="role-badge">{data.profile.role}</p>
					</div>
				</div>
				
				<div class="profile-body">
					<h3>{data.profile.aboutTitle}</h3>
					<div set:html={data.profile.aboutHtml}></div>
					
					<h3>{data.profile.locationTitle}</h3>
					<p class="location-info">
						{data.profile.locationText}
					</p>

					<div class="profile-socials">
						<h3>{data.profile.socialsTitle}</h3>
						<div class="social-icons">
							{data.profile.socials.map((social) => (
								<a href={social.link} target="_blank" class={`social-icon ${social.iconClass}`} aria-label={social.label} title={social.title} set:html={ICONS[social.icon]}>
								</a>
							))}
						</div>
					</div>
				</div>
			</div>

			<!-- Колонка с карьерой (без плашек и двойных обводок, компактно) -->
			<div class="career-block-clean">
				<h2>{data.career.title}</h2>
				<p class="section-desc">{data.career.desc}</p>
				
				<div class="contacts-cases-list">
					{data.career.items.map((item) => (
						<a href={item.link} class="contacts-case-item">
							<div class="case-number">{item.number}</div>
							<div class="case-info">
								<div class="career-year">{item.year}</div>
								<h4>{item.title}</h4>
								<p>{item.desc}</p>
							</div>
						</a>
					))}
				</div>
			</div>
		</div>

		<!-- Секция AI-агентов (команда роботов) -->
		<div class="container agents-section">
			<div class="agents-header">
				<h2>{data.agents.titleLead}<span class="gradient-text">{data.agents.titleAccent}</span></h2>
				<p class="agents-desc">{data.agents.desc}</p>
			</div>
			
			<div class="agents-grid">
				{data.agents.items.map((agent) => (
					<div class="agent-row-clean">
						<div class={`agent-avatar-box ${agent.colorClass}`} title={agent.name}>
							<img src={agent.imagePath} alt={agent.name} width="32" height="32" />
						</div>
						<div class="agent-text-inline">
							<strong>{agent.name}</strong> — {agent.desc}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>
</Layout>

<style>
	.contacts-page {
		position: relative;
		padding: 60px 0 100px 0;
		overflow: hidden;
	}

	.contacts-glow {
		position: absolute;
		top: -150px;
		left: 50%;
		transform: translateX(-50%);
		width: 1000px;
		height: 500px;
		background: radial-gradient(circle, var(--accent-purple-glow) 0%, rgba(13,15,20,0) 100%);
		filter: blur(80px);
		pointer-events: none;
		z-index: 1;
	}

	.contacts-container {
		position: relative;
		z-index: 2;
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 40px;
		align-items: start;
	}

	/* Профиль */
	.profile-card {
		padding: 40px;
		display: flex;
		flex-direction: column;
		gap: 30px;
	}

	.profile-header {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.avatar-wrapper {
		position: relative;
		width: 80px;
		height: 80px;
	}

	.avatar-placeholder {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		background: var(--grad-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 0 20px var(--accent-purple-glow);
		overflow: hidden;
	}

	.avatar-photo {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		border-radius: 50%;
		display: block;
	}

	.avatar-initials {
		font-family: 'Outfit', sans-serif;
		font-size: 1.8rem;
		font-weight: 800;
		color: #ffffff;
	}

	.avatar-glow-ring {
		position: absolute;
		top: -4px;
		left: -4px;
		width: 88px;
		height: 88px;
		border: 1px dashed var(--accent-cyan);
		border-radius: 50%;
		animation: rotateRing 15s linear infinite;
	}

	@keyframes rotateRing {
		0% { transform: rotate(0deg); }
		100% { transform: rotate(360deg); }
	}

	.profile-title h1 {
		font-size: 2.2rem;
		margin-bottom: 6px;
	}

	.role-badge {
		font-family: 'Outfit', sans-serif;
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--accent-cyan);
	}

	.profile-body h3 {
		font-size: 1.2rem;
		margin-bottom: 12px;
		margin-top: 24px;
	}

	.profile-body p {
		color: var(--text-muted);
		font-size: 1rem;
		line-height: 1.6;
		margin-bottom: 16px;
	}

	.location-info {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--glass-border);
		padding: 12px 16px;
		border-radius: 8px;
		font-weight: 500;
	}

	html.light .location-info {
		background: rgba(0, 0, 0, 0.01);
	}

	/* Социальные сети и мессенджеры (стилизация в точности как в шапке) */
	.profile-socials {
		margin-top: 30px;
		border-top: 1px solid var(--glass-border);
		padding-top: 24px;
	}

	.profile-socials h3 {
		font-size: 1rem;
		margin-bottom: 16px;
		color: var(--text-muted);
		text-transform: uppercase;
		letter-spacing: 0.8px;
	}

	.profile-socials .social-icons {
		display: flex;
		gap: 12px;
	}

	.profile-socials .social-icon {
		width: 38px;
		height: 38px;
		border-radius: 6px;
		border: 1px solid var(--glass-border);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
		transition: all var(--transition-fast);
		background: transparent;
	}

	/* Анимация пульсации рамочки для иконок в контактах */
	@keyframes borderPulseCyanContacts {
		0%, 100% { 
			border-color: var(--glass-border); 
			box-shadow: none;
		}
		50% { 
			border-color: var(--accent-cyan); 
			box-shadow: 0 0 6px var(--accent-cyan-glow);
		}
	}

	.profile-socials .social-icon.tg {
		animation: borderPulseCyanContacts 3s infinite ease-in-out;
	}

	.profile-socials .social-icon.wa {
		animation: borderPulseCyanContacts 3s infinite ease-in-out 0.75s;
	}

	.profile-socials .social-icon.vk {
		animation: borderPulseCyanContacts 3s infinite ease-in-out 1.5s;
	}

	.profile-socials .social-icon.insta {
		animation: borderPulseCyanContacts 3s infinite ease-in-out 2.25s;
	}

	.profile-socials .social-icon:hover {
		transform: translateY(-2px);
		animation: none;
	}

	.profile-socials .social-icon.tg:hover {
		color: #38bdf8;
		border-color: #38bdf8 !important;
		background: rgba(56, 189, 248, 0.05);
		box-shadow: 0 0 10px rgba(56, 189, 248, 0.2);
	}

	.profile-socials .social-icon.wa:hover {
		color: #4ade80;
		border-color: #4ade80 !important;
		background: rgba(74, 222, 128, 0.05);
		box-shadow: 0 0 10px rgba(74, 222, 128, 0.2);
	}

	.profile-socials .social-icon.vk:hover {
		color: #2787f5;
		border-color: #2787f5 !important;
		background: rgba(39, 135, 245, 0.05);
		box-shadow: 0 0 10px rgba(39, 135, 245, 0.2);
	}

	.profile-socials .social-icon.insta:hover {
		color: #f43f5e;
		border-color: #f43f5e !important;
		background: rgba(244, 63, 94, 0.05);
		box-shadow: 0 0 10px rgba(244, 63, 94, 0.2);
	}

	/* Кейсы и карьера (Изначальный дизайн с карточками contacts-case-item) */
	.contacts-content-group {
		display: flex;
		flex-direction: column;
		gap: 30px;
	}

	

	.section-desc {
		color: var(--text-muted);
		font-size: 0.95rem;
		margin-bottom: 24px;
	}

	.contacts-cases-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.career-block-clean {
		padding: 10px 0;
	}

	.career-block-clean h2 {
		font-size: 2.2rem;
		margin-bottom: 8px;
	}

	.contacts-case-item {
		display: flex;
		gap: 20px;
		padding: 14px 0;
		background: transparent !important;
		border: none !important;
		border-bottom: 1px solid rgba(255, 255, 255, 0.04) !important;
		border-radius: 0 !important;
		transition: transform var(--transition-fast), border-color var(--transition-fast) !important;
		text-decoration: none;
		color: inherit;
		box-shadow: none !important;
	}

	html.light .contacts-case-item {
		background: transparent !important;
		border-bottom: 1px solid rgba(0, 0, 0, 0.04) !important;
	}

	.contacts-case-item:last-child {
		border-bottom: none !important;
	}

	.contacts-case-item:hover {
		transform: translateX(6px) !important;
		border-bottom-color: rgba(255, 255, 255, 0.1) !important;
	}

	html.light .contacts-case-item:hover {
		border-bottom-color: rgba(0, 0, 0, 0.1) !important;
	}

	.case-number {
		font-family: 'Outfit', sans-serif;
		font-size: 1.8rem;
		font-weight: 800;
		color: var(--accent-cyan);
		line-height: 1;
		min-width: 35px;
	}

	.case-info {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.career-year {
		font-family: 'Outfit', sans-serif;
		font-weight: 700;
		font-size: 0.8rem;
		color: var(--accent-cyan);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.case-info h4 {
		font-size: 1.15rem;
		font-weight: 600;
		margin-bottom: 4px;
		transition: color var(--transition-fast);
		color: #ffffff;
	}

	html.light .case-info h4 {
		color: hsl(224, 25%, 12%);
	}

	.contacts-case-item:hover h4 {
		color: var(--accent-cyan);
	}

	.case-info p {
		font-size: 0.9rem;
		color: var(--text-muted);
		line-height: 1.5;
		margin: 0;
	}

	/* Адаптивность */
	@media (max-width: 992px) {
		.contacts-container {
			grid-template-columns: 1fr;
			gap: 40px;
		}
	}

	@media (max-width: 576px) {
		.profile-card,
		.cases-block {
			padding: 30px 20px;
		}
		.profile-header {
			flex-direction: column;
			text-align: center;
		}
		.contacts-case-item {
			flex-direction: column;
			gap: 12px;
		}
	}




	/* Ультра-компактные AI-агенты (2 строки по 3 агента в виде одной строки) */
	.agents-section {
		margin-top: 60px;
		border-top: 1px solid var(--glass-border);
		padding-top: 50px;
	}

	.agents-header {
		text-align: center;
		margin-bottom: 30px;
	}

	.agents-header h2 {
		font-size: 2.2rem;
		margin-bottom: 8px;
	}

	.agents-desc {
		color: var(--text-muted);
		font-size: 0.95rem;
		max-width: 600px;
		margin: 0 auto;
	}

	.agents-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr) !important;
		gap: 24px 20px;
		margin-top: 30px;
	}

	.agent-row-clean {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 6px 0;
	}

	.agent-avatar-box {
		width: 32px;
		height: 32px;
		border-radius: 6px;
		border: 1px solid var(--glass-border);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		background: transparent;
		transition: all var(--transition-fast);
		overflow: hidden;
	}

	.agent-avatar-box img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	@keyframes borderPulseAgent {
		0%, 100% { 
			border-color: var(--glass-border); 
			box-shadow: none;
		}
		50% { 
			border-color: var(--agent-glow-color); 
			box-shadow: 0 0 8px var(--agent-glow-shadow);
		}
	}

	/* Настройка цветов и задержки анимации пульсации рамочки для каждого робота */
	.agent-avatar-box.tg { 
		--agent-glow-color: #38bdf8; 
		--agent-glow-shadow: rgba(56, 189, 248, 0.4);
		animation: borderPulseAgent 4s infinite ease-in-out; 
	}
	.agent-avatar-box.vk { 
		--agent-glow-color: #2787f5; 
		--agent-glow-shadow: rgba(39, 135, 245, 0.4);
		animation: borderPulseAgent 4s infinite ease-in-out 0.6s; 
	}
	.agent-avatar-box.wa { 
		--agent-glow-color: #4ade80; 
		--agent-glow-shadow: rgba(74, 222, 128, 0.4);
		animation: borderPulseAgent 4s infinite ease-in-out 1.2s; 
	}
	.agent-avatar-box.insta { 
		--agent-glow-color: #f43f5e; 
		--agent-glow-shadow: rgba(244, 63, 94, 0.4);
		animation: borderPulseAgent 4s infinite ease-in-out 1.8s; 
	}
	.agent-avatar-box.amber { 
		--agent-glow-color: #f59e0b; 
		--agent-glow-shadow: rgba(245, 158, 11, 0.4);
		animation: borderPulseAgent 4s infinite ease-in-out 2.4s; 
	}
	.agent-avatar-box.emerald { 
		--agent-glow-color: #10b981; 
		--agent-glow-shadow: rgba(16, 185, 129, 0.4);
		animation: borderPulseAgent 4s infinite ease-in-out 3s; 
	}

	.agent-avatar-box:hover {
		transform: scale(1.05);
		border-color: var(--agent-glow-color) !important;
		box-shadow: 0 0 10px var(--agent-glow-shadow) !important;
		animation: none;
	}

	.agent-text-inline {
		font-size: 0.9rem;
		line-height: 1.4;
		color: var(--text-muted);
	}

	.agent-text-inline strong {
		color: #ffffff;
		font-family: 'Outfit', sans-serif;
		font-weight: 700;
	}

	html.light .agent-text-inline strong {
		color: hsl(224, 25%, 12%);
	}

	@media (max-width: 992px) {
		.agents-grid {
			grid-template-columns: repeat(2, 1fr) !important;
			gap: 20px 16px;
		}
	}

	@media (max-width: 650px) {
		.agents-grid {
			grid-template-columns: 1fr !important;
			gap: 16px;
		}
		.agent-row-clean {
			padding: 4px 0;
		}
	}

</style>

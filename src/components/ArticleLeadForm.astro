---
interface Props {
	articleTitle: string;
}

const { articleTitle } = Astro.props;
---

<section class="article-lead-form">
	<div class="lead-content">
		<h2>Узнайте, как внедрить <span>{articleTitle}</span> в ваш бизнес</h2>
		<p>Оставьте заявку, и мы бесплатно рассчитаем окупаемость внедрения AI-ассистента для вашей компании.</p>
	</div>
	
	<form class="lead-form" onsubmit="event.preventDefault(); alert('Форма отправлена! (Заглушка)');">
		<div class="form-group">
			<input type="text" placeholder="Ваше имя" required />
		</div>
		<div class="form-group">
			<input type="text" placeholder="Телефон или Telegram" required />
		</div>
		<button type="submit" class="submit-btn">Получить расчет</button>
		<p class="privacy">Нажимая кнопку, вы соглашаетесь с <a href="/privacy">политикой конфиденциальности</a></p>
	</form>
</section>

<style>
	.article-lead-form {
		margin: 60px 0 20px 0;
		padding: 50px;
		background: linear-gradient(135deg, rgba(13, 15, 20, 0.8) 0%, rgba(6, 182, 212, 0.05) 100%);
		border: 1px solid var(--glass-border);
		border-radius: 24px;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 40px;
		align-items: center;
		position: relative;
		overflow: hidden;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
	}
	
	html.light .article-lead-form {
		background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(99, 102, 241, 0.05) 100%);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.05);
	}

	.article-lead-form::before {
		content: '';
		position: absolute;
		top: -50%;
		left: -50%;
		width: 200%;
		height: 200%;
		background: radial-gradient(circle at 70% 30%, rgba(147, 51, 234, 0.15), transparent 60%);
		pointer-events: none;
	}

	.lead-content h2 {
		font-size: 2.2rem;
		line-height: 1.2;
		margin-bottom: 20px;
		color: #fff;
		letter-spacing: -0.5px;
	}

	html.light .lead-content h2 {
		color: #111;
	}

	.lead-content h2 span {
		background: var(--grad-primary);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.lead-content p {
		color: var(--text-muted);
		font-size: 1.1rem;
		line-height: 1.6;
	}

	.lead-form {
		display: flex;
		flex-direction: column;
		gap: 16px;
		position: relative;
		z-index: 2;
	}

	.form-group input {
		width: 100%;
		padding: 16px 20px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid var(--glass-border);
		border-radius: 12px;
		color: #fff;
		font-size: 1rem;
		font-family: inherit;
		transition: all 0.3s ease;
	}
	
	html.light .form-group input {
		background: rgba(0, 0, 0, 0.03);
		color: #111;
		border-color: rgba(0, 0, 0, 0.1);
	}

	.form-group input:focus {
		outline: none;
		border-color: var(--accent-cyan);
		background: rgba(255, 255, 255, 0.06);
		box-shadow: 0 0 15px rgba(6, 182, 212, 0.2);
	}
	
	html.light .form-group input:focus {
		background: rgba(255, 255, 255, 0.9);
	}

	.submit-btn {
		width: 100%;
		padding: 18px;
		background: var(--grad-primary);
		color: #fff;
		border: none;
		border-radius: 12px;
		font-size: 1.1rem;
		font-weight: 600;
		cursor: pointer;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
		box-shadow: 0 10px 20px rgba(147, 51, 234, 0.2);
	}

	.submit-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 15px 30px rgba(6, 182, 212, 0.3);
	}

	.privacy {
		font-size: 0.8rem;
		color: var(--text-muted);
		text-align: center;
		margin-top: 8px;
	}

	.privacy a {
		color: var(--accent-cyan);
		text-decoration: none;
	}

	.privacy a:hover {
		text-decoration: underline;
	}

	@media (max-width: 992px) {
		.article-lead-form {
			grid-template-columns: 1fr;
			padding: 40px 30px;
			gap: 30px;
		}
		
		.lead-content h2 {
			font-size: 1.8rem;
		}
	}
</style>

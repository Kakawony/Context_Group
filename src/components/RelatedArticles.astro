---
interface Props {
	currentCategory: string;
	currentUrl: string;
}

const { currentCategory, currentUrl } = Astro.props;

// Получаем все статьи
const rawPosts = Object.values(import.meta.glob('../pages/blog/*.md', { eager: true })) as any[];

// Фильтруем по категории, исключаем текущую статью, сортируем по дате и берем 3 штуки
const relatedPosts = rawPosts
	.filter(post => post.frontmatter.category === currentCategory && post.url !== currentUrl)
	.sort((a, b) => {
		const parseDate = (dStr: string) => {
			if (!dStr) return 0;
			const parts = dStr.split('.');
			if (parts.length === 3) {
				const [d, m, y] = parts.map(Number);
				return new Date(y, m - 1, d).getTime();
			}
			return 0;
		};
		return parseDate(b.frontmatter.date) - parseDate(a.frontmatter.date);
	})
	.slice(0, 3);
---

{relatedPosts.length > 0 && (
	<section class="related-articles">
		<div class="related-header">
			<h2>Дополнительные материалы</h2>
			<p>Статьи, инструкции и кейсы по теме «{currentCategory}»</p>
		</div>

		<div class="related-scroll-container">
			<div class="related-grid">
				{relatedPosts.map(post => (
					<a href={post.url} class="glass-card related-card">
						<div class="related-visual">
							{post.frontmatter.image ? (
								<img src={post.frontmatter.image} alt={post.frontmatter.title} class="related-image" />
							) : (
								<div class="related-icon-placeholder">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
									</svg>
								</div>
							)}
						</div>
						<div class="related-content">
							<div class="related-meta">
								<span class="related-category">{post.frontmatter.category}</span>
								<span class="meta-separator">&bull;</span>
								<time>{post.frontmatter.date}</time>
							</div>
							<h3>{post.frontmatter.title}</h3>
							<p class="related-desc">{post.frontmatter.description || "Узнайте подробности в статье..."}</p>
							<span class="read-more">Читать &rarr;</span>
						</div>
					</a>
				))}
			</div>
		</div>
	</section>
)}

<style>
	.related-articles {
		margin-top: 60px;
		padding-top: 60px;
		border-top: 1px solid var(--glass-border);
		position: relative;
		z-index: 2; /* Выше шарика */
	}

	.related-header {
		margin-bottom: 30px;
	}

	.related-header h2 {
		font-size: 2rem;
		margin-bottom: 8px;
		color: #fff;
	}
	html.light .related-header h2 { color: #111; }

	.related-header p {
		color: var(--text-muted);
		font-size: 1.1rem;
	}

	/* Горизонтальный скролл контейнер */
	.related-scroll-container {
		width: 100%;
		overflow-x: auto;
		padding-bottom: 20px; /* Для скроллбара */
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		scrollbar-color: var(--accent-purple) transparent;
	}

	.related-scroll-container::-webkit-scrollbar {
		height: 6px;
	}
	.related-scroll-container::-webkit-scrollbar-track {
		background: rgba(255, 255, 255, 0.05);
		border-radius: 10px;
	}
	.related-scroll-container::-webkit-scrollbar-thumb {
		background: var(--accent-purple);
		border-radius: 10px;
	}

	.related-grid {
		display: flex;
		gap: 20px;
		width: max-content; /* Чтобы карточки не сжимались, а уходили в скролл */
	}

	.related-card {
		display: flex;
		flex-direction: column;
		width: 320px; /* Фиксированная ширина карточки в карусели */
		padding: 0;
		overflow: hidden;
		transition: transform 0.3s ease, border-color 0.3s ease;
	}

	.related-card:hover {
		transform: translateY(-5px);
		border-color: rgba(147, 51, 234, 0.5);
	}

	.related-visual {
		width: 100%;
		height: 160px;
		background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(147, 51, 234, 0.05) 100%);
		display: flex;
		align-items: center;
		justify-content: center;
		border-bottom: 1px solid var(--glass-border);
		position: relative;
		overflow: hidden;
	}

	.related-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}
	
	.related-card:hover .related-image {
		transform: scale(1.05);
	}

	.related-icon-placeholder {
		color: var(--accent-cyan);
		opacity: 0.5;
	}

	.related-content {
		padding: 24px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.related-meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.8rem;
		color: var(--text-muted);
		margin-bottom: 12px;
	}

	.related-category {
		color: var(--accent-cyan);
		border: 1px solid rgba(6, 182, 212, 0.3);
		padding: 2px 8px;
		border-radius: 4px;
		text-transform: uppercase;
		font-size: 0.7rem;
		font-weight: 600;
	}

	.related-card h3 {
		font-size: 1.15rem;
		line-height: 1.4;
		margin-bottom: 12px;
		color: #fff;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	html.light .related-card h3 { color: #111; }

	.related-desc {
		font-size: 0.9rem;
		color: var(--text-muted);
		margin-bottom: 20px;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex-grow: 1;
	}

	.read-more {
		color: var(--accent-purple);
		font-weight: 600;
		font-size: 0.9rem;
		transition: color 0.3s ease;
	}
	
	html.light .read-more {
		color: #6b21a8;
	}

	@media (max-width: 768px) {
		.related-card {
			width: 280px;
		}
		.related-header h2 {
			font-size: 1.6rem;
		}
	}
</style>

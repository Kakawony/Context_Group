---
interface Props {
	title?: string;
}

const { title = "Внедрение AI в ваш бизнес" } = Astro.props;
---

<div class="sidebar-banner" id="articleSidebarBanner">
	<div class="banner-glow"></div>
	<div class="banner-content">
		<div class="banner-badge">Консультация</div>
		<h3>{title}</h3>
		<p>Узнайте, как автоматизировать рутину и сэкономить от 200 000 ₽ в месяц с помощью AI-агентов.</p>
		
		<div class="banner-features">
			<div class="feature-item">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
				<span>Аудит процессов</span>
			</div>
			<div class="feature-item">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="check-icon"><polyline points="20 6 9 17 4 12"></polyline></svg>
				<span>Интеграция с CRM</span>
			</div>
		</div>

		<a href="/audit-vnedreniya-ai" class="btn btn-primary banner-btn"><span>Бесплатный аудит</span></a>
	</div>
</div>

<style>
	.sidebar-banner {
		position: sticky;
		top: 100px; /* Отступ от верхнего края при скролле */
		background: rgba(13, 15, 20, 0.6);
		border: 1px solid var(--glass-border);
		border-radius: 20px;
		padding: 24px;
		overflow: hidden;
		backdrop-filter: blur(10px);
		box-shadow: 0 20px 40px rgba(0,0,0,0.2);
		z-index: 2; /* Выше шарика */
	}

	html.light .sidebar-banner {
		background: rgba(255, 255, 255, 0.7);
		box-shadow: 0 15px 35px rgba(0,0,0,0.05);
	}

	.banner-glow {
		position: absolute;
		top: -50%;
		right: -50%;
		width: 150%;
		height: 150%;
		background: radial-gradient(circle, rgba(147, 51, 234, 0.15) 0%, rgba(0,0,0,0) 70%);
		pointer-events: none;
	}
	
	html.light .banner-glow {
		background: radial-gradient(circle, rgba(147, 51, 234, 0.08) 0%, rgba(255,255,255,0) 70%);
	}

	.banner-content {
		position: relative;
		z-index: 1;
	}

	.banner-badge {
		display: inline-block;
		background: rgba(6, 182, 212, 0.1);
		color: var(--accent-cyan);
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 1px;
		padding: 4px 10px;
		border-radius: 999px;
		margin-bottom: 16px;
	}

	.sidebar-banner h3 {
		font-size: 1.4rem;
		line-height: 1.3;
		margin-bottom: 12px;
		color: #fff;
	}
	html.light .sidebar-banner h3 { color: #111; }

	.sidebar-banner p {
		font-size: 0.95rem;
		color: var(--text-muted);
		margin-bottom: 20px;
		line-height: 1.5;
	}

	.banner-features {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-bottom: 24px;
	}

	.feature-item {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.9rem;
		color: var(--text-main);
	}

	.check-icon {
		color: var(--accent-cyan);
		flex-shrink: 0;
	}

	.banner-btn {
		width: 100%;
		text-align: center;
		justify-content: center;
		padding: 12px;
		font-size: 1rem;
	}
</style>

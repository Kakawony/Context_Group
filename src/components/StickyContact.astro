<style>
	.sticky-contact {
		position: fixed;
		left: 20px;
		top: 75%;
		transform: translateY(-50%);
		z-index: 1000;
		display: flex;
		flex-direction: column;
		align-items: center;
		transition: all 0.3s ease;
	}

	.sticky-contact-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 12px;
		
		/* Без подложки */
		background: transparent;
		color: #ffffff;
		border: none;
		box-shadow: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		border-radius: 0;
		padding: 0;
	}

	/* Светлая тема */
	html.light .sticky-contact-inner {
		background: transparent;
		color: hsl(224, 25%, 12%);
		border: none;
		box-shadow: none;
	}

	.sticky-text {
		font-family: 'Outfit', sans-serif;
		font-size: 0.95rem;
		font-weight: 700;
		color: currentColor;
		white-space: nowrap;
		margin-bottom: 4px;
		text-shadow: 0 2px 10px rgba(0,0,0,0.5);
	}
	
	html.light .sticky-text {
		text-shadow: none;
	}

	.sticky-socials {
		display: flex;
		flex-direction: row;
		gap: 12px;
	}

	.sticky-icon {
		width: 44px;
		height: 44px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all var(--transition-fast);
		
		/* Темная тема */
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.15);
		background: rgba(255, 255, 255, 0.05);
		backdrop-filter: blur(8px);
	}

	/* Светлая тема */
	html.light .sticky-icon {
		color: hsl(224, 25%, 12%);
		border: 1px solid rgba(0, 0, 0, 0.15);
		background: rgba(0, 0, 0, 0.05);
	}

	@keyframes borderPulseCyanSticky {
		0%, 100% { box-shadow: none; }
		50% { box-shadow: 0 0 12px var(--accent-cyan-glow); }
	}

	.sticky-icon.tg {
		animation: borderPulseCyanSticky 3s infinite ease-in-out;
		color: #38bdf8 !important;
		border-color: rgba(56, 189, 248, 0.5) !important;
		background: rgba(56, 189, 248, 0.1) !important;
	}

	.sticky-icon.wa {
		animation: borderPulseCyanSticky 3s infinite ease-in-out 1.5s;
		color: #4ade80 !important;
		border-color: rgba(74, 222, 128, 0.5) !important;
		background: rgba(74, 222, 128, 0.1) !important;
	}

	.sticky-icon:hover {
		transform: scale(1.1);
		animation: none;
	}

	.sticky-icon.tg:hover, .sticky-icon.wa:hover {
		color: #ffffff;
		border-color: rgba(255, 255, 255, 0.15) !important;
		background: rgba(255, 255, 255, 0.05);
	}
	
	html.light .sticky-icon.tg:hover, html.light .sticky-icon.wa:hover {
		color: hsl(224, 25%, 12%);
		border-color: rgba(0, 0, 0, 0.15) !important;
		background: rgba(0, 0, 0, 0.05);
	}

	/* Мобильная версия: плашка прикреплена снизу по центру */
	@media (max-width: 992px) {
		.sticky-contact {
			top: auto;
			bottom: max(24px, env(safe-area-inset-bottom, 24px));
			left: 50%;
			transform: translateX(-50%);
			width: auto;
			max-width: 90vw;
		}

		.sticky-contact-inner {
			flex-direction: row;
			padding: 8px 16px;
			border-radius: 50px;
			gap: 16px;
			justify-content: center;
			width: auto;
			background: rgba(15, 20, 25, 0.6);
			border: 1px solid rgba(255,255,255,0.05);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			box-shadow: 0 4px 20px rgba(0,0,0,0.3);
		}
		
		html.light .sticky-contact-inner {
			background: rgba(255, 255, 255, 0.85);
			border: 1px solid rgba(0,0,0,0.05);
		}

		.sticky-text {
			margin-bottom: 0;
			font-size: 0.9rem;
		}

		.sticky-icon {
			width: 36px;
			height: 36px;
		}
		
		.sticky-icon svg {
			width: 16px;
			height: 16px;
		}
	}
</style>

---
const faqs = [
	{
		question: "Как быстро окупается внедрение AI-бота?",
		answer: "В среднем, внедрение окупается за 1-2 месяца за счет сокращения ФОТ на операторов первой линии и увеличения конверсии благодаря моментальным ответам 24/7."
	},
	{
		question: "Сможет ли бот общаться как живой человек?",
		answer: "Да, современные LLM-модели (на базе которых мы строим ботов) понимают контекст, юмор и могут вести диалог в заданном Tone of Voice вашей компании. Клиенты часто даже не понимают, что общаются с AI."
	},
	{
		question: "Что если AI придумает несуществующую скидку?",
		answer: "Мы используем технологию RAG (Retrieval-Augmented Generation). Бот получает жесткую инструкцию отвечать только на основе предоставленной базы знаний. Вероятность галлюцинаций сведена к нулю."
	}
];

const schema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": faqs.map(faq => ({
		"@type": "Question",
		"name": faq.question,
		"acceptedAnswer": {
			"@type": "Answer",
			"text": faq.answer
		}
	}))
};
---

<section class="blog-faq">
	<h2 class="faq-title">Часто задаваемые вопросы</h2>
	
	<div class="faq-list">
		{faqs.map((faq, index) => (
			<details class="faq-item" name="blog-faqs">
				<summary class="faq-question">
					{faq.question}
					<span class="faq-icon">+</span>
				</summary>
				<div class="faq-answer">
					<p>{faq.answer}</p>
				</div>
			</details>
		))}
	</div>

	<!-- Микроразметка для SEO -->
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
	.blog-faq {
		margin: 60px 0;
		padding: 40px;
		background: rgba(13, 15, 20, 0.4);
		border: 1px solid var(--glass-border);
		border-radius: 20px;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
		backdrop-filter: blur(10px);
	}
	
	html.light .blog-faq {
		background: rgba(255, 255, 255, 0.6);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
	}

	.faq-title {
		font-size: 2rem;
		margin-bottom: 30px;
		color: #fff;
		letter-spacing: -0.5px;
	}
	
	html.light .faq-title {
		color: #111;
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.faq-item {
		border-bottom: 1px solid var(--glass-border);
	}
	
	.faq-item:last-child {
		border-bottom: none;
	}

	.faq-question {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 20px 0;
		font-size: 1.1rem;
		font-weight: 600;
		color: #fff;
		cursor: pointer;
		list-style: none; /* Убираем стандартный треугольник */
		transition: color 0.3s ease;
	}
	
	html.light .faq-question {
		color: #222;
	}

	.faq-question::-webkit-details-marker {
		display: none;
	}

	.faq-question:hover {
		color: var(--accent-cyan);
	}

	.faq-icon {
		font-size: 1.5rem;
		color: var(--accent-purple);
		transition: transform 0.3s ease;
		font-weight: 300;
	}

	details[open] .faq-icon {
		transform: rotate(45deg);
		color: var(--accent-cyan);
	}

	.faq-answer {
		padding-bottom: 20px;
		color: var(--text-muted);
		font-size: 1.05rem;
		line-height: 1.6;
		animation: fadeIn 0.3s ease-in-out;
	}

	@keyframes fadeIn {
		from { opacity: 0; transform: translateY(-10px); }
		to { opacity: 1; transform: translateY(0); }
	}
</style>

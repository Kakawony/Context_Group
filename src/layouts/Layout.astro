---
import '../styles/global.css';
import StickyContact from '../components/StickyContact.astro';
import { CONTACT_TELEGRAM_URL, CONTACT_TELEGRAM_HANDLE } from '../data/site';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
	ogImage?: string;
	/** Язык страницы (ru по умолчанию). Задел под будущий раздел /en/. */
	lang?: 'ru' | 'en';
}

const {
	title,
	description = "Context Group — высокотехнологичный маркетинг на территории России с применением искусственного интеллекта. Автоматизация, AI-боты, автопостинг, SEO контент-планы.",
	noindex = false,
	ogImage = '/og-default.png',
	lang = 'ru'
} = Astro.props;

const ogLocale = lang === 'en' ? 'en_US' : 'ru_RU';

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImageURL = ogImage ? new URL(ogImage, Astro.site ?? Astro.url.origin).href : undefined;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<!-- Preload основного шрифта первого экрана (Inter 400, кириллица+латиница) — убирает рендер-блок и swap-мигание -->
		<link rel="preload" href="/fonts/inter-400-cyrillic.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#0d0f14" />
		<meta name="generator" content={Astro.generator} />

		<!-- Верификация вебмастеров -->
		<meta name="yandex-verification" content="ff0193ace2072ddc" />
		<meta name="google-site-verification" content="kaoOxZxvM_GaY_sM1jOAyp-KRKYcsrYvXhIJwBPUxwk" />

		<!-- Yandex.Metrika counter -->
		<script type="text/javascript" is:inline>
			(function(m,e,t,r,i,k,a){
				m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
				m[i].l=1*new Date();
				for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
				k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
			})(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=109796718', 'ym');

			ym(109796718, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
		</script>
		<noscript><div><img src="https://mc.yandex.ru/watch/109796718" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
		<!-- /Yandex.Metrika counter -->

		<!-- Пульс фавикона во вкладке (только в браузере; в выдаче поисковиков статичный favicon.svg) -->
		<script is:inline>
			(function () {
				if (!window.requestAnimationFrame || !document.createElement('canvas').getContext) return;
				if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
				var c = document.createElement('canvas'); c.width = 64; c.height = 64;
				var x = c.getContext('2d');
				var link = document.createElement('link');
				link.rel = 'icon'; link.type = 'image/png';
				document.head.appendChild(link);
				function draw(p) {
					x.clearRect(0, 0, 64, 64);
					// прозрачный фон — без подложки; пульсирующее свечение в фирменных цветах
					var glow = x.createRadialGradient(32, 32, 3, 32, 32, 20 + 10 * p);
					glow.addColorStop(0, 'rgba(249,6,79,' + (0.40 + 0.40 * p) + ')');
					glow.addColorStop(0.6, 'rgba(147,85,246,' + (0.10 + 0.12 * p) + ')');
					glow.addColorStop(1, 'rgba(147,85,246,0)');
					x.fillStyle = glow; x.beginPath(); x.arc(32, 32, 31, 0, 7); x.fill();
					// орбита
					x.save(); x.translate(32, 32); x.rotate(-0.45);
					x.strokeStyle = 'rgba(249,6,79,0.7)'; x.lineWidth = 2;
					x.beginPath(); x.ellipse(0, 0, 26, 10, 0, 0, 7); x.stroke(); x.restore();
					// ядро-сфера (розово-красный → фиолетовый, как на hero)
					var core = x.createRadialGradient(27, 24, 1, 32, 32, 16);
					core.addColorStop(0, '#ffd6e6'); core.addColorStop(0.32, '#f9064f'); core.addColorStop(1, '#9355f6');
					x.fillStyle = core; x.beginPath(); x.arc(32, 32, 15, 0, 7); x.fill();
					// блик
					x.fillStyle = 'rgba(255,255,255,0.5)'; x.beginPath(); x.ellipse(27, 25, 4, 2.6, -0.5, 0, 7); x.fill();
					try { link.href = c.toDataURL('image/png'); } catch (e) {}
				}
				var last = 0;
				function loop(ts) {
					if (ts - last > 90) { last = ts; draw((Math.sin(ts / 750) + 1) / 2); }
					requestAnimationFrame(loop);
				}
				requestAnimationFrame(loop);
			})();
		</script>

		<!-- SEO Meta Tags -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{ogImageURL && <meta property="og:image" content={ogImageURL} />}

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		{ogImageURL && <meta property="twitter:image" content={ogImageURL} />}

		<!-- Инициализация темы без мерцания (FOUC) -->
		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				// Если настроек нет, проверяем системную темную тему (iOS, MacOS, Windows и т.д.)
				if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light'; // По умолчанию для всех остальных — светлая
			})();
			if (theme === 'light') {
				document.documentElement.classList.add('light');
			} else {
				document.documentElement.classList.remove('light');
			}
		</script>
	</head>

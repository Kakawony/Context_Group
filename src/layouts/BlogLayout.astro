---
import Layout from './Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AiSphere from '../components/AiSphere.astro';
import TableOfContents from '../components/TableOfContents.astro';
import BlogFAQ from '../components/BlogFAQ.astro';
import ArticleSidebarBanner from '../components/ArticleSidebarBanner.astro';
import ArticleMobileCTA from '../components/ArticleMobileCTA.astro';
import RelatedArticles from '../components/RelatedArticles.astro';

interface Frontmatter {
	title: string;
	description?: string;
	date: string;
	category: string;
	readTime: string;
}

const { frontmatter, headings = [] } = Astro.props as { frontmatter: Frontmatter, headings: any[] };
---

<Layout title={`${frontmatter.title} | Блог Context Group`} description={frontmatter.description} ogType="article">
	<AiSphere alwaysVisible={true} scale={0.33} />

	<article class="blog-article">
		<div class="article-glow"></div>
		<div class="container article-container">
			<div class="article-layout">
				<!-- Основная колонка (Текст, FAQ) -->
				<div class="article-main">
					<Breadcrumbs items={[{ label: 'Блог', href: '/blog' }, { label: frontmatter.title }]} />
					
					<div class="article-meta">
						<a href="/blog" class="back-link">&larr; Вернуться в блог</a>
						<div class="meta-row">
							<span class="category-tag">{frontmatter.category}</span>
							<span class="meta-separator">&bull;</span>
							<time datetime={frontmatter.date}>{frontmatter.date}</time>
							<span class="meta-separator">&bull;</span>
							<span>{frontmatter.readTime}</span>
						</div>
					</div>

					<h1 class="article-title">{frontmatter.title}</h1>
					
					<TableOfContents headings={headings} />

					<div class="article-content" id="articleContent">
						<slot />
					</div>
					
					{frontmatter.category !== 'Карьера' && <BlogFAQ />}
				</div>

				<!-- Боковая колонка (Рекламный баннер) -->
				<aside class="article-sidebar" id="sidebarContainer">
					<ArticleSidebarBanner />
				</aside>
			</div>
			
			<!-- Дополнительные материалы (внизу) -->
			<RelatedArticles currentCategory={frontmatter.category} currentUrl={Astro.url.pathname} />
		</div>
	</article>

	<!-- Мобильный призыв к действию: «горящая» AI-вкладка слева + выезжающая шторка -->
	<ArticleMobileCTA />

	<script>
		// Железобетонный скролл для таблиц
		document.addEventListener('DOMContentLoaded', () => {
			const tables = document.querySelectorAll('.article-content table');
			tables.forEach(table => {
				const wrapper = document.createElement('div');
				wrapper.className = 'table-responsive';
				if (table.parentNode) {
					table.parentNode.insertBefore(wrapper, table);
					wrapper.appendChild(table);
				}
			});
		});
	</script>
</Layout>

<style is:global>
	/* Стили для контента Markdown */
	.blog-article {
		position: relative;
		padding: 60px 0 100px 0;
		overflow: clip; /* clip не ломает position: sticky, в отличие от hidden */
	}

	.article-glow {
		position: absolute;
		top: -100px;
		left: 50%;
		transform: translateX(-50%);
		width: 800px;
		height: 400px;
		background: radial-gradient(circle, var(--accent-cyan-glow) 0%, rgba(13,15,20,0) 100%);
		filter: blur(80px);
		pointer-events: none;
		z-index: 1;
	}

	.article-container {
		position: relative;
		z-index: 2;
	}

	.article-layout {
		display: flex;
		align-items: flex-start;
		gap: 40px;
		width: 100%;
		max-width: 100vw;
	}

	.article-main {
		flex: 1;
		min-width: 0; /* Критично важно, чтобы контент не распирал flex-контейнер */
		max-width: 100%; /* Дополнительная защита от переполнения */
		background: rgba(13, 15, 20, 0.4);
		padding: 40px;
		border-radius: 24px;
		border: 1px solid var(--glass-border);
		backdrop-filter: blur(10px);
	}
	html.light .article-main {
		background: rgba(255, 255, 255, 0.6);
	}

	.article-sidebar {
		width: 320px;
		flex-shrink: 0;
		position: sticky;
		top: 100px; /* Отступ от верхнего края */
	}

	.mobile-banner-wrapper {
		margin: 40px 0;
		width: 100%;
	}

	.article-meta {
		margin-bottom: 30px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.back-link {
		color: var(--accent-cyan);
		font-weight: 500;
		font-size: 0.95rem;
		align-self: flex-start;
		display: flex;
		align-items: center;
		gap: 8px;
		transition: gap 0.3s ease;
	}

	.back-link:hover {
		gap: 12px;
	}

	.meta-row {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 0.9rem;
		color: var(--text-muted);
	}

	.category-tag {
		background: rgba(147, 51, 234, 0.1);
		border: 1px solid rgba(147, 51, 234, 0.2);
		color: var(--accent-purple);
		padding: 6px 16px;
		border-radius: 9999px;
		font-weight: 600;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.article-title {
		font-size: 2.6rem;
		line-height: 1.2;
		margin-bottom: 40px;
		letter-spacing: -1px;
		background: linear-gradient(to right, #fff, var(--text-muted));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
	html.light .article-title {
		background: linear-gradient(to right, #000, var(--text-muted));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	/* РЕДИЗАЙН ТИПОГРАФИКИ MARKDOWN */
	.article-content {
		font-size: 1.15rem;
		line-height: 1.85;
		color: var(--text-main);
		font-family: 'Inter', sans-serif;
	}

	.article-content p {
		margin-bottom: 28px;
		font-weight: 400;
	}

	.article-content h2 {
		font-size: 2rem;
		margin: 60px 0 24px 0;
		letter-spacing: -0.5px;
		color: #fff;
		display: flex;
		align-items: center;
		gap: 12px;
	}
	html.light .article-content h2 {
		color: #111;
	}
	
	/* Кастомная черточка у H2 */
	.article-content h2::before {
		content: '';
		display: block;
		width: 24px;
		height: 4px;
		background: var(--grad-primary);
		border-radius: 4px;
	}

	.article-content h3 {
		font-size: 1.5rem;
		margin: 40px 0 16px 0;
		color: #fff;
	}
	html.light .article-content h3 {
		color: #111;
	}

	/* Списки */
	.article-content ul, 
	.article-content ol {
		margin-bottom: 30px;
		padding-left: 0;
		list-style: none;
	}

	.article-content li {
		margin-bottom: 12px;
		position: relative;
		padding-left: 30px;
	}

	.article-content ul li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 10px;
		width: 8px;
		height: 8px;
		background: var(--accent-cyan);
		border-radius: 50%;
		box-shadow: 0 0 10px var(--accent-cyan);
	}
	
	.article-content ol {
		counter-reset: my-counter;
	}
	.article-content ol li::before {
		counter-increment: my-counter;
		content: counter(my-counter) ".";
		position: absolute;
		left: 0;
		top: 0;
		color: var(--accent-purple);
		font-weight: 700;
		font-size: 1.1rem;
	}

	/* Цитаты */
	.article-content blockquote {
		margin: 40px 0;
		padding: 30px 40px;
		background: linear-gradient(135deg, rgba(255,255,255,0.03) 0%, rgba(255,255,255,0.01) 100%);
		border: 1px solid var(--glass-border);
		border-radius: 20px;
		font-style: italic;
		color: #fff;
		position: relative;
		box-shadow: 0 10px 30px rgba(0,0,0,0.2);
	}
	html.light .article-content blockquote {
		background: linear-gradient(135deg, rgba(0,0,0,0.03) 0%, rgba(0,0,0,0.01) 100%);
		color: #111;
		box-shadow: 0 10px 30px rgba(0,0,0,0.05);
	}
	
	.article-content blockquote::before {
		content: '\"';
		position: absolute;
		top: -10px;
		left: 20px;
		font-size: 6rem;
		color: rgba(147, 51, 234, 0.2);
		font-family: serif;
		line-height: 1;
	}

	.article-content blockquote p {
		margin-bottom: 0;
		position: relative;
		z-index: 2;
		font-size: 1.25rem;
		line-height: 1.7;
	}

	/* Ссылки в тексте статьи (СТАНДАРТ: cyan + подчёркивание, hover → purple) */
	.article-content a {
		color: var(--accent-cyan);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
		font-weight: 500;
		transition: color 0.2s ease;
	}
	.article-content a:hover {
		color: var(--accent-purple);
	}

	/* Выделение жирным */
	.article-content strong {
		color: #fff;
		font-weight: 700;
		background: rgba(6, 182, 212, 0.1);
		padding: 2px 6px;
		border-radius: 4px;
	}
	html.light .article-content strong {
		color: #000;
		background: rgba(6, 182, 212, 0.15);
	}

	/* Разделитель (HR) */
	.article-content hr {
		border: none;
		height: 2px;
		background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
		margin: 60px 0;
		position: relative;
	}
	html.light .article-content hr {
		background: linear-gradient(90deg, transparent, rgba(0,0,0,0.1), transparent);
	}
	.article-content hr::after {
		content: '';
		position: absolute;
		top: -3px;
		left: 50%;
		transform: translateX(-50%);
		width: 8px;
		height: 8px;
		background: var(--accent-cyan);
		border-radius: 50%;
		box-shadow: 0 0 10px var(--accent-cyan);
	}

	/* ТАБЛИЦЫ - адаптивные под выдачу */
	.table-responsive {
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		margin: 40px 0;
		border-radius: 16px;
		box-shadow: 0 15px 35px rgba(0,0,0,0.2);
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid var(--glass-border);
	}
	html.light .table-responsive {
		background: rgba(255, 255, 255, 0.6);
		box-shadow: 0 15px 35px rgba(0,0,0,0.05);
	}

	.article-content table {
		width: 100%;
		border-collapse: collapse; /* Сменил с separate чтобы не было багов в адаптивной обертке */
		white-space: nowrap; /* Важно для горизонтального скролла */
		min-width: 600px; /* Заставляем таблицу скроллиться на узких экранах */
	}

	.article-content th,
	.article-content td {
		padding: 18px 24px;
		text-align: left;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}
	html.light .article-content table {
		background: rgba(255, 255, 255, 0.6);
		box-shadow: 0 15px 35px rgba(0,0,0,0.05);
	}

	.article-content img {
		max-width: 100%;
		max-height: 450px;
		width: 100%;
		object-fit: cover;
		display: block;
		border-radius: 12px;
		margin: 40px auto;
		box-shadow: 0 10px 30px rgba(0,0,0,0.3);
	}
	.article-content th,
	.article-content td {
		padding: 18px 24px;
		text-align: left;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}
	html.light .article-content th,
	html.light .article-content td {
		border-bottom: 1px solid rgba(0, 0, 0, 0.05);
	}

	.article-content th {
		background: rgba(147, 51, 234, 0.1);
		color: #fff;
		font-weight: 600;
		font-size: 1.05rem;
		text-transform: uppercase;
		letter-spacing: 1px;
	}
	html.light .article-content th {
		color: #111;
		background: rgba(147, 51, 234, 0.05);
	}

	.article-content tr:last-child td {
		border-bottom: none;
	}

	.article-content tr {
		transition: background 0.3s ease;
	}

	.article-content tbody tr:hover {
		background: rgba(255, 255, 255, 0.05);
	}
	html.light .article-content tbody tr:hover {
		background: rgba(0, 0, 0, 0.02);
	}

	/* SEO Сводка (Врезка) */
	.article-content .seo-summary {
		background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(147, 51, 234, 0.05) 100%);
		border-left: 4px solid var(--accent-cyan);
		padding: 24px 30px;
		margin: 40px 0;
		border-radius: 0 16px 16px 0;
		position: relative;
	}
	
	.article-content .seo-summary::before {
		content: '⚡ SEO Summary';
		display: block;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: var(--accent-cyan);
		font-weight: 700;
		margin-bottom: 12px;
	}

	.article-content .seo-summary p {
		margin-bottom: 0;
		font-size: 1.05rem;
		line-height: 1.6;
		color: #fff;
	}
	html.light .article-content .seo-summary p {
		color: #222;
	}

	.article-content code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 0.95rem;
		background: rgba(255, 255, 255, 0.1);
		padding: 4px 8px;
		border-radius: 6px;
		color: var(--accent-cyan);
	}

	.article-content pre code {
		background: transparent;
		padding: 0;
		color: #e6edf3;
	}

	@media (max-width: 992px) {
		.article-layout {
			flex-direction: column;
			gap: 40px;
		}
		
		.article-sidebar {
			display: none; /* Скрываем оригинальный контейнер сайдбара, баннер перемещается JS-ом */
		}
	}

	@media (max-width: 768px) {
		.article-main {
			padding: 20px;
		}
		
		.article-title {
			font-size: 1.85rem;
			margin-bottom: 28px;
		}
		
		.table-responsive {
			margin: 20px 0;
		}
		
		.article-content th,
		.article-content td {
			padding: 12px 14px;
			font-size: 0.85rem;
		}
		
		.article-content .seo-summary {
			padding: 20px;
		}
		
		.article-content {
			font-size: 1.05rem;
		}
		
		.article-content blockquote {
			padding: 20px;
		}
	}
</style>
